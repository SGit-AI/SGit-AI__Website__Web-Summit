<title>Agent Setup Guide</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,500..800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: a field guide. One reading column, a sticky "read this as" bar, instruments (dials, meters, tiles) where the reader decides something. */
:root{
  --ink:#161615; --paper:#F7F6F2; --panel:#EFEDE6; --line:#D9D6CC; --muted:#5E5C55;
  --green:#1A7F5A; --green-ink:#156E4E; --gold-ink:#9A4508; --green-soft:#DCEDE4; --gold:#B45309; --gold-soft:#F6E7D6;
  --red:#A8322D; --red-soft:#F4DEDB; --track:#E2DFD6;
  --display:"Archivo","Arial Narrow",system-ui,sans-serif;
  --body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --ink:#ECEAE3; --paper:#121311; --panel:#1C1E1B; --line:#34372F; --muted:#A5A398; --green-ink:var(--green); --gold-ink:var(--gold);
  --green:#4FBF8E; --green-soft:#17352A; --gold:#E39A4B; --gold-soft:#3A2817; --red:#E5776F; --red-soft:#3D1F1C; --track:#2A2D27; color-scheme:dark}}
:root[data-theme="dark"]{
  --ink:#ECEAE3; --paper:#121311; --panel:#1C1E1B; --line:#34372F; --muted:#A5A398; --green-ink:var(--green); --gold-ink:var(--gold);
  --green:#4FBF8E; --green-soft:#17352A; --gold:#E39A4B; --gold-soft:#3A2817; --red:#E5776F; --red-soft:#3D1F1C; --track:#2A2D27; color-scheme:dark}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.6}
.wrap{max-width:1000px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0}
.col{max-width:68ch}
h1,h2,h3{font-family:var(--display);font-stretch:85%;line-height:1.1;text-wrap:balance;margin:0}
h1{font-size:clamp(2.1rem,6vw,3.5rem);font-weight:800;letter-spacing:-.01em}
h2{font-size:clamp(1.5rem,3.4vw,2.1rem);font-weight:750}
h3{font-size:1.12rem;font-weight:700}
p{margin:0}
a{color:var(--green)}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
svg{display:block}
.ico{width:28px;height:28px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}
.eyebrow{font-family:var(--mono);font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.mono{font-family:var(--mono);font-size:.82rem}
.tag{font-family:var(--mono);font-size:.74rem;padding:2px 8px;border-radius:4px;background:var(--green-soft);color:var(--green-ink)}
.tag.gold{background:var(--gold-soft);color:var(--gold-ink)}
.meta{display:flex;flex-wrap:wrap;gap:6px 10px}
.warn{color:var(--gold)} .ok{color:var(--green-ink)}


/* hero */
.hero{padding-block:36px 24px;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:28px;align-items:center}
.hero .txt{display:grid;gap:14px;min-width:0}
.lede{font-size:1.12rem;color:var(--muted);max-width:56ch}
.hero-art{width:100%;max-width:400px;justify-self:center}
@media (max-width:760px){.hero{grid-template-columns:1fr}.hero-art{max-width:300px}}
.orbit{transform-origin:200px 200px}
@media (prefers-reduced-motion:no-preference){.orbit{animation:spin 60s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}}

/* read-as bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--paper)}
.readas{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--paper);border-block:1px solid var(--line)}
.readas .wrap{display:flex;gap:8px;align-items:center;overflow-x:auto;padding-block:9px;scrollbar-width:thin}
.chip{flex:none;display:flex;gap:6px;align-items:center;font:500 .86rem var(--body);border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:999px;padding:5px 12px 5px 8px;cursor:pointer}
.chip .ico{width:18px;height:18px}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}

.thirty{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:start;border-left:4px solid var(--green);background:var(--panel);padding:18px 20px;margin-top:22px;border-radius:0 8px 8px 0}
.thirty .badge{width:54px;height:54px;border-radius:50%;background:var(--green);color:var(--paper);display:grid;place-items:center}
.thirty .badge .ico{width:28px;height:28px}
.thirty .q{font-family:var(--display);font-weight:700;font-size:1.25rem;font-stretch:85%}
.thirty>div{display:grid;gap:8px;min-width:0}
.depth{display:flex;gap:3px;align-items:center}
.depth i{width:14px;height:6px;border-radius:2px;background:var(--track)}
.depth i.on{background:var(--gold)}

section{padding-block:40px;border-top:1px solid var(--line);display:grid;gap:18px}
.sechead{display:grid;gap:6px}
.foryou{border:1px dashed var(--green);border-radius:8px;padding:12px 14px;display:none;gap:6px;grid-template-columns:auto minmax(0,1fr);align-items:start}
.foryou .ico{color:var(--green);width:22px;height:22px;margin-top:2px}
.foryou>div{display:grid;gap:4px;min-width:0}
.foryou .eyebrow{color:var(--green)}
ul.plain{margin:0;padding-left:18px;display:grid;gap:4px}

/* questionnaires */
.tabs{display:flex;gap:8px;flex-wrap:wrap}
.tab{display:flex;gap:8px;align-items:center;font:600 .92rem var(--body);background:transparent;border:1px solid var(--line);color:var(--ink);padding:8px 14px;border-radius:8px;cursor:pointer}
.tab .ico{width:20px;height:20px}
.tab[aria-selected="true"]{background:var(--green);border-color:var(--green);color:var(--paper)}
form.quiz{display:grid;gap:20px;background:var(--panel);border-radius:10px;padding:18px}form.quiz[hidden]{display:none}
fieldset{border:0;margin:0;padding:0;display:grid;gap:8px;min-width:0}
legend{font-weight:600;margin-bottom:6px;padding:0}
.progress{height:6px;background:var(--track);border-radius:3px;overflow:hidden}
.progress i{display:block;height:100%;width:0;background:var(--green);transition:width .3s}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.tile{position:relative;display:grid;gap:6px;justify-items:start;align-content:start;background:var(--paper);border:1.5px solid var(--line);border-radius:8px;padding:10px;font-size:.86rem;line-height:1.3;cursor:pointer}
.tile input{position:absolute;opacity:0;pointer-events:none}
#reach-tiles,#qb-opts{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:640px){#reach-tiles,#qb-opts{grid-template-columns:repeat(2,minmax(0,1fr))}}
.tile .ico{color:var(--muted)}
.tile:has(input:checked){border-color:var(--green);background:var(--green-soft)}
.tile:has(input:checked) .ico{color:var(--green)}
.tile:has(input:focus-visible){outline:2px solid var(--gold);outline-offset:2px}
.pills{display:flex;flex-wrap:wrap;gap:8px}
.pill{position:relative;display:flex;gap:6px;align-items:center;background:var(--paper);border:1.5px solid var(--line);border-radius:999px;padding:6px 12px;font-size:.88rem;cursor:pointer}
.pill input{position:absolute;opacity:0;pointer-events:none}
.pill:has(input:checked){border-color:var(--green);background:var(--green-soft);color:var(--green-ink)}
.pill:has(input:focus-visible){outline:2px solid var(--gold);outline-offset:2px}
.stepper{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px}
.stepper label{position:relative;display:grid;justify-items:center;gap:4px;padding:8px 2px;border-radius:6px;background:var(--paper);border:1.5px solid var(--line);font-size:.72rem;text-align:center;line-height:1.2;cursor:pointer}
.stepper input{position:absolute;opacity:0;pointer-events:none}
.stepper .ico{width:22px;height:22px;color:var(--muted)}
.stepper label:has(input:checked){border-color:var(--gold);background:var(--gold-soft)}
.stepper label:has(input:checked) .ico{color:var(--gold)}
.stepper label:has(input:focus-visible){outline:2px solid var(--gold);outline-offset:2px}
@media (max-width:560px){.stepper{grid-template-columns:repeat(3,minmax(0,1fr))}}
input[type=range]{width:100%;accent-color:var(--green)}
.slider-labels{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted)}
.btn{font:600 .95rem var(--body);background:var(--ink);color:var(--paper);border:0;border-radius:8px;padding:11px 18px;cursor:pointer;justify-self:start}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.result{border:2px solid var(--green);border-radius:10px;padding:18px;display:grid;gap:14px;background:var(--paper)}
.result-top{display:grid;grid-template-columns:180px minmax(0,1fr);gap:18px;align-items:center}
@media (max-width:560px){.result-top{grid-template-columns:1fr;justify-items:center;text-align:center}}
.result ol,.result ul{margin:0;padding-left:20px;display:grid;gap:6px}
.fix{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;align-items:start;padding:10px;border-radius:8px;background:var(--panel)}
.fix .ico{color:var(--green)}

/* ladder */
.ladder-art{width:100%;height:auto}
.steps{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}
.step{display:grid;gap:6px;align-content:start;min-width:0;background:var(--panel);border-radius:8px;padding:12px;border-top:4px solid var(--line)}
.step.you{border-top-color:var(--gold);background:var(--gold-soft)}
.step b{font-family:var(--display);font-stretch:85%;font-size:1rem}
.step small{color:var(--muted);font-size:.8rem;line-height:1.4}
.reachbar{height:6px;border-radius:3px;background:var(--track);overflow:hidden}
.reachbar i{display:block;height:100%;background:linear-gradient(90deg,var(--green),var(--gold),var(--red))}
@media (max-width:760px){.steps{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* levels */
.levels3{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.lv{border-radius:10px;padding:14px;display:grid;gap:8px;align-content:start;min-width:0;border:1px solid var(--line)}
.lv .ico{width:34px;height:34px}
.lv.l1 .ico{color:var(--muted)} .lv.l2 .ico{color:var(--gold)} .lv.l3 .ico{color:var(--green)}
.lv.l2{background:var(--gold-soft);border-color:transparent} .lv.l3{background:var(--green-soft);border-color:transparent}
@media (max-width:980px){.levels3{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:700px){.levels3{grid-template-columns:1fr}}
.lvl{display:inline-block;font-family:var(--mono);font-size:.72rem;padding:1px 7px;border-radius:4px}
.lvl.l1{background:var(--panel);color:var(--muted);border:1px solid var(--line)}
.lvl.l2{background:var(--gold-soft);color:var(--gold-ink)}
.lvl.l3{background:var(--green-soft);color:var(--green-ink)}
.deps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
@media (max-width:760px){.deps{grid-template-columns:repeat(2,minmax(0,1fr))}}
.dep{display:grid;gap:6px;justify-items:start;align-content:start;text-align:left;font:500 .86rem/1.3 var(--body);color:var(--ink);background:var(--paper);border:1.5px solid var(--line);border-radius:8px;padding:10px;cursor:pointer}
.dep .ico{color:var(--muted)}
.dep[aria-pressed="true"]{border-color:var(--ink);background:var(--panel)}
.dep[aria-pressed="true"] .ico{color:var(--ink)}
.console{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:22px;background:var(--panel);border-radius:12px;padding:18px;align-items:center}
@media (max-width:700px){.console{grid-template-columns:1fr}}
.console .read{display:grid;gap:10px;min-width:0}
.verdict{display:flex;gap:8px;align-items:center;font-weight:600}
.verdict .dot{width:12px;height:12px;border-radius:50%}
.scroll{overflow-x:auto}table.kinds{min-width:0!important}table.kinds th{white-space:normal}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th,td{text-align:left;vertical-align:top;padding:9px 10px;border-bottom:1px solid var(--line)}
th{font-family:var(--mono);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:500}
details.more{border:1px solid var(--line);border-radius:8px;padding:10px 14px}
details.more summary{cursor:pointer;font-weight:600}
details.more[open] summary{margin-bottom:10px}

/* setup */
.dec{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:10px}
.dec details{border:1px solid var(--line);border-radius:8px;padding:12px 14px;background:var(--paper)}
.dec summary{cursor:pointer;font-weight:600;display:flex;gap:10px;align-items:center}
.dec summary .ico{width:22px;height:22px;color:var(--green)}
.dec details[open] summary{margin-bottom:8px}
.seg{display:flex;flex-wrap:wrap;gap:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;width:fit-content;max-width:100%}
.seg button{font:500 .86rem var(--body);background:transparent;color:var(--ink);border:0;border-right:1px solid var(--line);padding:8px 12px;cursor:pointer}
.seg button:last-child{border-right:0}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
.prodtable td.hi,.prodtable th.hi{background:var(--green-soft)}

/* lessons */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.card{border:1px solid var(--line);border-radius:10px;padding:14px;display:grid;gap:8px;align-content:start}
.card .ico{width:34px;height:34px;color:var(--green)}
.oss{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.oss a.card{color:var(--ink);text-decoration:none}
.oss a.card:hover{border-color:var(--green)}
.lic{font-family:var(--mono);font-size:.74rem;color:var(--green)}
footer{padding-block:30px 60px;color:var(--muted);font-size:.84rem;border-top:1px solid var(--line);display:grid;gap:6px}
@media (prefers-reduced-motion:no-preference){.result,.console .read{animation:rise .25s ease-out}@keyframes rise{from{transform:translateY(4px)}to{transform:none}}#needle{transition:transform .5s cubic-bezier(.3,1.4,.5,1)}}
</style>

<!-- the icon set, drawn once -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
 <defs>
  <symbol id="i-ceo" viewBox="0 0 24 24"><path d="M4 20V10l8-6 8 6v10"/><path d="M9 20v-6h6v6"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></symbol>
  <symbol id="i-privacy" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/><circle cx="12" cy="15" r="1.4"/></symbol>
  <symbol id="i-code" viewBox="0 0 24 24"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></symbol>
  <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/></symbol>
  <symbol id="i-robot" viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="11" rx="3"/><path d="M12 4v4M9 13h.01M15 13h.01M9.5 16.5h5"/><circle cx="12" cy="3.5" r="1"/></symbol>
  <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/></symbol>
  <symbol id="i-all" viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></symbol>
  <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7h6l2 2h10v10H3z"/></symbol>
  <symbol id="i-plug" viewBox="0 0 24 24"><path d="M9 3v5M15 3v5M7 8h10v4a5 5 0 01-10 0zM12 17v4"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></symbol>
  <symbol id="i-team" viewBox="0 0 24 24"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M3 19c0-3 2.5-5 5-5s5 2 5 5M11 19c0-3 2.5-5 5-5s5 2 5 5"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
  <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 15h6"/></symbol>
  <symbol id="i-server" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="1.5"/><rect x="4" y="14" width="16" height="6" rx="1.5"/><path d="M8 7h.01M8 17h.01"/></symbol>
  <symbol id="i-person" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></symbol>
  <symbol id="i-coin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.7 0-2.8 1-2.8 2.2 0 2.8 5.6 1.4 5.6 4 0 1.3-1.2 2.3-2.8 2.3-1.1 0-2.2-.6-2.7-1.6M12 6.5v11"/></symbol>
  <symbol id="i-megaphone" viewBox="0 0 24 24"><path d="M3 10v4h4l8 4V6L7 10zM18 9a4 4 0 010 6"/></symbol>
  <symbol id="i-inbox" viewBox="0 0 24 24"><path d="M3 13l3-8h12l3 8v6H3z"/><path d="M3 13h5l1 2h6l1-2h5"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></symbol>
  <symbol id="i-hub" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><circle cx="4" cy="5" r="2"/><circle cx="20" cy="5" r="2"/><circle cx="4" cy="19" r="2"/><circle cx="20" cy="19" r="2"/><path d="M6 6.5l4 3.5M18 6.5l-4 3.5M6 17.5l4-3.5M18 17.5l-4-3.5"/></symbol>
  <symbol id="i-tiers" viewBox="0 0 24 24"><path d="M4 18h16M6 14h12M8 10h8M10 6h4"/></symbol>
  <symbol id="i-warn" viewBox="0 0 24 24"><path d="M12 3l10 18H2z"/><path d="M12 10v5M12 18h.01"/></symbol>
  <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="14" r="4"/><path d="M11 11l9-9M16 6l3 3"/></symbol>
  <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 20a2 2 0 004 0"/></symbol>
  <symbol id="i-scale" viewBox="0 0 24 24"><path d="M12 4v16M5 20h14M4 8h16M7 8l-3 6h6zM17 8l-3 6h6z"/></symbol>
  <symbol id="i-path" viewBox="0 0 24 24"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M8 6h6a4 4 0 010 8h-4a4 4 0 000 8"/></symbol>
  <symbol id="i-switch" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="16" cy="12" r="2.5"/></symbol>
  <symbol id="i-question" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 015 0c0 1.7-2.5 2-2.5 4M12 17h.01"/></symbol>
  <symbol id="i-wrench" viewBox="0 0 24 24"><path d="M14 6a4 4 0 005 5l-8 8a2 2 0 01-3-3z"/></symbol>
 </defs>
</svg>


<div class="wrap">
<header class="hero">
 <div class="txt">
  <span class="eyebrow">A guide for anyone starting with agents · by Angelo</span>
  <h1>Set up your AI agents, and decide what each one may do</h1>
  <p class="lede">From a few chats you copy and paste between, to a team of agents that works while you sleep. Each step gives your agents more reach. This guide shows what each step needs, what it risks, and how much control to put around it.</p>
  <div class="meta"><span class="tag">Works with any agent product</span><span class="tag">Open source tools</span><span class="tag gold">Tested on our own team, Web Summit 2026</span></div>
 </div>
 <svg class="hero-art" viewBox="0 0 400 400" role="img" aria-label="A person at the centre, three agents around them, each agent's reach drawn as a ring, and a barrier cutting off part of one ring">
