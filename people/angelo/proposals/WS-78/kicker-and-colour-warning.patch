+// 21. the kicker (WS-78, proposed by dev@web-summit.angelo): every page with a title says its section and its source
+for (const f of htmlFiles) { const h = read(rel(f)); if (/<h1>/.test(h) && !h.includes('class="hm-hero"') && !/<p class="kicker">/.test(h)) errors.push(`${rel(f)}: a title with no kicker (its section and source file)`) }
+// 22. colour through tokens beyond site.css (WS-78): a warning for now, counted per stylesheet, so the debt is visible; it
+// becomes a failure once each stylesheet marks its own tokens block (/* tokens:start */ ... /* tokens:end */)
+{
+    const warn = []
+    for (const f of files.filter(f => f.endsWith('.css') && !rel(f).endsWith('assets/site.css') && !/(^|\/)(vendor|node_modules)\//.test(rel(f)))) {
