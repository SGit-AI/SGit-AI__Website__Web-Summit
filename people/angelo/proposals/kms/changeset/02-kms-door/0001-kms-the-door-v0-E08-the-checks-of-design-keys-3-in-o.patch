+ "routes": [
+  {"method": "POST", "path": "/v0/init", "op": "init", "callers": ["launcher"], "body": "{policy_hash, expires, session_auth_pub?}"},
+  {"method": "GET", "path": "/v0/identity", "op": "identity", "callers": ["net", "llm", "launcher"], "body": "none"},
+  {"method": "POST", "path": "/v0/unwrap", "op": "unwrap", "callers": ["net"], "body": "{v, op, sealed, vault_id, eph_pub, nonce, ts, policy_hash, sig?}"},
