diff --git a/sharness_ai/kms/Crypto.py b/sharness_ai/kms/Crypto.py
new file mode 100644
index 0000000..aebf3be
--- /dev/null
+++ b/sharness_ai/kms/Crypto.py
@@ -0,0 +1,84 @@
+"""The kms's cryptography, behind one small interface, so that the door's checks (who, when, which
+policy, how often) are written once and the primitives can be chosen separately.
+
+A backend opens a sealed vault key (check 5), derives the per-operation keys from it (check 6),
+seals a response to the caller's one-time key E (§3 "Sealing to E"), re-seals to another identity
+(`seal_to`), makes and reports the session identity, verifies the session auth key's signature
+(check 2, remote kms) and scrubs. Every clear key it hands the door is a `bytearray`, so the door
+can zero it in place after use (the design's "scrub Python bytes after copying").
+
+`NoCrypto` is the default and refuses everything with `Unavailable` (the door answers 501): the
+standard library has no ECDH, no ECDSA and no AES-GCM, and the openssl 3.0 command line refuses
+AEAD ciphers (`enc: AEAD ciphers not supported`), so the design's envelope cannot be built here
+without a dependency exception. That choice is the upstream's, not this patch's."""
+from dataclasses import dataclass
+
+
+class CryptoRefusal(Exception):
+    """A sealed input that must be refused (not addressed to us, a bad signature, expired, an
+    unknown sender). The message is the reason given to the caller: never a key, never plaintext."""
+
+
+class Unavailable(Exception):
+    """No backend can do this here."""
+
+
+@dataclass
+class Opened:
+    vault_id  : str
+    vault_key : bytearray          # clear, inside the kms only; the door zeroes it after derive
+    sender_fp : str                # "sha256:<16 hex>" of the sender's signing key
+    expires   : int                # Unix seconds; the sealed key's own expiry (policy, not cryptography)
+
+
+class Crypto:
+    name = "crypto"
+
+    def identity(self):                                      # {"k1", "record_fp", "enc_fp"} or None
+        raise Unavailable(self.why())
+
+    def make_identity(self) -> dict:
+        raise Unavailable(self.why())
+
+    def verify(self, auth_pub: str, message: bytes, sig: str) -> bool:
+        raise Unavailable(self.why())
+
+    def open(self, sealed: str, pins: dict) -> Opened:       # check 5; raises CryptoRefusal
+        raise Unavailable(self.why())
+
+    def derive(self, opened: Opened, op: str) -> dict:       # check 6: {"read_key": bytearray, "write_key"?: bytearray, ...}
+        raise Unavailable(self.why())
+
+    def seal_to_eph(self, plain: bytearray, eph_pub: str, nonce: bytes, info: bytes, aad: bytes) -> str:
+        raise Unavailable(self.why())
+
+    def seal_to(self, opened: Opened, recipient_k1: str, expires: int, op: str) -> str:
+        raise Unavailable(self.why())
+
+    def scrub(self):
+        pass
+
+    def why(self) -> str:
+        return f"the {self.name} backend cannot do this"
+
+
+class NoCrypto(Crypto):
+    name = "none"
+
+    def identity(self):
+        return None
+
+    def why(self) -> str:
+        return ("no cryptography backend: the envelope of design/keys §3 needs ECDH P-256, HKDF and AES-256-GCM, which the "
+                "standard library lacks and the openssl 3.0 command line refuses (AEAD); choosing one is the upstream's decision")
+
+
+def scrub(*buffers):
+    """Zero each bytearray in place (best effort: a copy Python made earlier is not reached)."""
+    for b in buffers:
+        if isinstance(b, bytearray):
+            for i in range(len(b)):
+                b[i] = 0
+
+
+__all__ = ["Crypto", "CryptoRefusal", "NoCrypto", "Opened", "Unavailable", "scrub"]
