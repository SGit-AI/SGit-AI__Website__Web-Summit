diff --git a/sharness_ai/kms/KMS.py b/sharness_ai/kms/KMS.py
new file mode 100644
index 0000000..138e031
--- /dev/null
+++ b/sharness_ai/kms/KMS.py
@@ -0,0 +1,269 @@
+"""sharness.kms, the door (E08, v0): the checks of sharness.ai/design/keys §3, in their order.
+
+    unwrap   1 the TLS peer is net            2 sig, when init bound an auth key
+             3 ts within 60 s; nonce unseen   4 policy hash is ours; a kms row of this session's agent
+                                                allows op for vault_id, and has not run out (until)
+             5 open sealed (the backend)      6 vault id inside == vault_id; derive; scrub the vault key
+             7 limits: max_uses; write needs a fresh approval
+             8 the audit line: the door's own line, whose `row` names op, vault id and agent, never a key
+    seal_to  the same checks, with `op` the right handed on; it always needs a fresh approval
+    init     the launcher only: the policy hash must be ours; makes the identity once
+    identity its public half only; destroy: the launcher only, scrubs, idempotent; then every call is 410
+
+One session is one agent: the launcher starts the kms with that agent's name, and only the kms rows
+naming it count (piece 1's rows, `policy["kms"]`). Nothing here holds a clear key longer than one
+request: the backend hands keys over as bytearrays and they are zeroed before the answer is sent."""
+import base64
+import binascii
+import calendar
+import hashlib
+import json
+import os
+import threading
+import time
+
+from sharness_ai.door import Contract, Door, Verdict
+from sharness_ai.kms.Crypto import CryptoRefusal, NoCrypto, Unavailable, scrub
+from sharness_ai.policy import kms_problems, policy_hash
+
+HERE = os.path.dirname(__file__)
+MAX_BODY = 16 << 10                      # §3: strict schemas, size-capped
+SKEW = 60                                # check 3: ts within ±60 s
+NONCE_KEEP = 120                         # nonces recorded until ts + 2 min
+EXPIRES_IN = 300                         # the unwrap response's expires_in
+MAX_TEXT = 8192                          # a sealed m1 or a k1, as text
+FIELDS = {
+    "unwrap":  ({"v", "op", "sealed", "vault_id", "eph_pub", "nonce", "ts", "policy_hash"}, {"sig"}),
+    "seal_to": ({"v", "op", "sealed", "vault_id", "recipient_k1", "expires", "nonce", "ts", "policy_hash"}, {"sig"}),
+    "init":    ({"policy_hash", "expires"}, {"session_auth_pub"}),
+    "destroy": (set(), set()),
+}
+P256_SPKI = 91                           # an uncompressed P-256 SubjectPublicKeyInfo, DER
+
+
+def canonical(doc: dict) -> bytes:
+    return json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+
+
+def b64(text, size: int = None):
+    """The bytes, or None: strict base64, of exactly `size` bytes when given."""
+    if not isinstance(text, str) or len(text) > MAX_TEXT:
+        return None
+    try:
+        raw = base64.b64decode(text, validate=True)
+    except (binascii.Error, ValueError):
+        return None
+    return raw if size is None or len(raw) == size else None
+
+
+def parse_ts(text):
+    """Unix seconds from "YYYY-MM-DDTHH:MM:SSZ", or None."""
+    try:
+        return calendar.timegm(time.strptime(text, "%Y-%m-%dT%H:%M:%SZ")) if isinstance(text, str) and len(text) == 20 else None
+    except ValueError:
+        return None
+
+
+class KMS(Door):
+    role = "kms"
+
+    def __init__(self, session, policy: dict, agent: str, crypto=None, approve=None, pins: dict = None,
+                 port: int = 0, audit_stream=None, clock=time.time):
+        problems = kms_problems(policy.get("kms", []))
+        if problems:
+            raise ValueError(f"the kms rows are not valid: {problems[0]}")
+        self.agent, self.crypto = agent, crypto or NoCrypto()
+        self.approve = approve                      # callable(agent, vault_id, op) -> bool: a fresh approval, or None (none here)
+        self.pins = dict(pins or {})                # {"root": "sha256:…"} and/or {"senders": [...]}: whom a sealed key may come from
+        self.clock, self.lock = clock, threading.Lock()
+        self.nonces, self.uses = {}, {}             # nonce -> keep-until; (agent, vault_id) -> successful unwraps
+        self.auth_pub, self.destroyed = None, False
+        self.rows = {r["vault_id"]: r for r in policy.get("kms", []) if r["agent"] == agent}
+        super().__init__(session, Contract(HERE), policy, port=port, audit_stream=audit_stream,
+                         targets={"sharness.kms.none" if isinstance(self.crypto, NoCrypto) else f"sharness.kms.{self.crypto.name}": "live"})
+
+    # ---- the door ---------------------------------------------------------------------------------------
+    def handle(self, request: dict) -> Verdict:
+        route, peer, body = request["route"], request["peer"], request["body"]
+        op = route["op"]
+        with self.lock:                             # one request at a time: nonces and counts are exact
+            if peer not in route.get("callers", ()):                                       # check 1
+                return Verdict.refuse(f"{op} is for {', '.join(route.get('callers', ()))} only, not {peer or '?'}", "check 1: the peer role")
+            if self.destroyed:
+                if op == "destroy":
+                    return Verdict.ok()                     # idempotent
+                return Verdict.refuse("this kms was destroyed; a new session starts a new one", "destroy", status=410)
+            if op == "identity":
+                ident = self.crypto.identity()
+                if not ident:
+                    return Verdict.refuse("no identity yet: the launcher calls init first", "init", status=409)
+                return Verdict.ok(k1=ident["k1"], record_fp=ident["record_fp"], enc_fp=ident["enc_fp"])
+            if len(body) > MAX_BODY:
+                return Verdict.refuse(f"body over {MAX_BODY} bytes", "§3 size cap", status=413)
+            doc, why = self.schema(op, body)
+            if doc is None:
+                return Verdict.refuse(why, "§3 strict schema", status=400)
+            try:
+                return getattr(self, f"op_{op}")(doc)
+            except Unavailable as e:
+                return Verdict.refuse(str(e), f"backend {self.crypto.name}", status=501)
+
+    def schema(self, op: str, body: bytes):
+        need, may = FIELDS[op]
+        try:
+            doc = json.loads(body or b"{}")
+        except (ValueError, UnicodeDecodeError):
+            return None, "the body is not JSON"
+        if not isinstance(doc, dict):
+            return None, "the body is not one JSON object"
+        missing, extra = sorted(need - set(doc)), sorted(set(doc) - need - may)
+        if missing or extra:
+            return None, f"fields: missing {missing}, unknown {extra}"
+        if op in ("unwrap", "seal_to"):
+            if doc["v"] != 1 or isinstance(doc["v"], bool):
+                return None, "v must be 1"
+            if doc["op"] not in ("read", "write"):
+                return None, "op must be read or write"
+            for k in ("sealed", "vault_id", "policy_hash", "ts") + (("recipient_k1",) if op == "seal_to" else ()):
+                if not isinstance(doc[k], str) or not doc[k] or len(doc[k]) > MAX_TEXT:
+                    return None, f"{k} must be a non-empty string"
+            if b64(doc["nonce"], 16) is None:
+                return None, "nonce must be 16 bytes, base64"
+            if op == "unwrap" and b64(doc["eph_pub"], P256_SPKI) is None:
+                return None, "eph_pub must be a P-256 public key (SPKI DER, base64)"
+            if parse_ts(doc["ts"]) is None:
+                return None, "ts must be YYYY-MM-DDTHH:MM:SSZ"
+        if "expires" in doc and (isinstance(doc["expires"], bool) or not isinstance(doc["expires"], int) or doc["expires"] < 0):
+            return None, "expires must be a Unix time in whole seconds"
+        if "sig" in doc and b64(doc["sig"]) is None:
+            return None, "sig must be base64"
+        return doc, ""
+
+    # ---- the ops -----------------------------------------------------------------------------------------
+    def op_init(self, doc) -> Verdict:
+        if doc["policy_hash"] != policy_hash(self.policy):
+            return Verdict.refuse("policy_hash is not this kms's policy", "check 4: the policy hash")
+        if self.crypto.identity():
+            return Verdict.refuse("this kms already has an identity; one per session", "init", status=409)
+        pub = doc.get("session_auth_pub")
+        if pub is not None and b64(pub, P256_SPKI) is None:
+            return Verdict.refuse("session_auth_pub must be a P-256 public key (SPKI DER, base64)", "§3 strict schema", status=400)
+        ident = self.crypto.make_identity()
+        self.auth_pub = pub
+        return Verdict.ok(k1=ident["k1"], record_fp=ident["record_fp"], enc_fp=ident["enc_fp"])
+
+    def op_destroy(self, doc) -> Verdict:
+        self.crypto.scrub()
+        self.nonces.clear()
+        self.uses.clear()
+        self.auth_pub, self.destroyed = None, True
+        return Verdict.ok()
+
+    def checks_2_to_4(self, doc):
+        """None when the request passes checks 2, 3 and 4; else the refusal."""
+        signed = {k: v for k, v in doc.items() if k != "sig"}
+        if self.auth_pub is not None:                                                         # check 2
+            if "sig" not in doc:
+                return Verdict.refuse("this kms is bound to a session auth key: the request must be signed", "check 2: sig")
+            if not self.crypto.verify(self.auth_pub, canonical(signed), doc["sig"]):
+                return Verdict.refuse("sig does not verify with the bound session auth key", "check 2: sig")
+        now = self.clock()                                                                     # check 3
+        ts = parse_ts(doc["ts"])
+        if abs(now - ts) > SKEW:
+            return Verdict.refuse(f"ts is {int(now - ts)} s from this kms's clock; at most {SKEW}", "check 3: ts")
+        for n, until in list(self.nonces.items()):
+            if until < now:
+                del self.nonces[n]
+        if doc["nonce"] in self.nonces:
+            return Verdict.refuse("nonce seen before: a replay", "check 3: nonce")
+        self.nonces[doc["nonce"]] = ts + NONCE_KEEP                                           # recorded even if refused below
+        if doc["policy_hash"] != policy_hash(self.policy):                                    # check 4
+            return Verdict.refuse("policy_hash is not this kms's policy", "check 4: the policy hash")
+        row = self.rows.get(doc["vault_id"])
+        where = f"kms[{self.agent}, {doc['vault_id']}]"
+        if row is None:
+            return Verdict.refuse(f"no kms row lets {self.agent} use vault {doc['vault_id']}", f"check 4: no row {where}")
+        if doc["op"] not in row["ops"]:
+            return Verdict.refuse(f"the row allows {row['ops']}, not {doc['op']}", f"check 4: {where} ops")
+        if now >= row["until"]:
+            return Verdict.refuse("the row has run out (until)", f"check 4: {where} until")
+        return None
+
+    def opened(self, doc):
+        """Checks 5 and the first half of 6: (opened, None) or (None, refusal)."""
+        try:
+            o = self.crypto.open(doc["sealed"], self.pins)                                    # check 5
+        except CryptoRefusal as e:
+            return None, Verdict.refuse(f"sealed: {e}", "check 5: open")
+        if o.expires <= self.clock():
+            scrub(o.vault_key)
+            return None, Verdict.refuse("the sealed key has expired", "check 5: expiry")
+        if o.vault_id != doc["vault_id"]:                                                     # check 6: what is inside decides
+            scrub(o.vault_key)
+            return None, Verdict.refuse("vault_id is not the vault inside sealed", "check 6: vault id")
+        return o, None
+
+    def limits(self, doc, sealing: bool = False):
+        """Check 7: None, or the refusal. Counts only what then succeeds."""
+        key, row = (self.agent, doc["vault_id"]), self.rows[doc["vault_id"]]
+        if self.uses.get(key, 0) >= row["max_uses"]:
+            return Verdict.refuse(f"max_uses {row['max_uses']} reached", f"check 7: kms[{self.agent}, {doc['vault_id']}] max_uses")
+        if doc["op"] == "write" or sealing:
+            if self.approve is None or not self.approve(self.agent, doc["vault_id"], "seal_to" if sealing else doc["op"]):
+                return Verdict.refuse("needs a fresh approval, and none was given", "check 7: fresh approval")
+        return None
+
+    def done(self, doc, verb: str, **body) -> Verdict:
+        key = (self.agent, doc["vault_id"])
+        self.uses[key] = self.uses.get(key, 0) + 1
+        v = Verdict.ok(**body)
+        v.row = f"{verb} {doc['op']} kms[{self.agent}, {doc['vault_id']}] use {self.uses[key]}"   # check 8: the audit line's row
+        return v
+
+    def op_unwrap(self, doc) -> Verdict:
+        refused = self.checks_2_to_4(doc)
+        if refused:
+            return refused
+        o, refused = self.opened(doc)
+        if refused:
+            return refused
+        keys, plain = {}, bytearray()
+        try:
+            keys = self.crypto.derive(o, doc["op"])                                         # check 6
+            scrub(o.vault_key)
+            if doc["op"] == "read" and "write_key" in keys:
+                return Verdict.refuse("the backend derived a write key for a read", "check 6: derive")
+            refused = self.limits(doc)                                                       # check 7
+            if refused:
+                return refused
+            plain = bytearray(b'{"vault_id":' + json.dumps(o.vault_id).encode())
+            for k in sorted(keys):
+                plain += b',"' + k.encode() + b'":"' + base64.b64encode(keys[k]) + b'"'
+            plain += b"}"
+            info = b"|".join((b"sgit-kms/v1", doc["op"].encode(), doc["vault_id"].encode(), b64(doc["eph_pub"])))
+            env = self.crypto.seal_to_eph(plain, doc["eph_pub"], b64(doc["nonce"], 16), info,
+                                          hashlib.sha256(canonical(doc)).digest())
+            return self.done(doc, "unwrap", v=1, sealed_to_eph=env, expires_in=EXPIRES_IN)
+        finally:
+            scrub(o.vault_key, plain, *keys.values())
+
+    def op_seal_to(self, doc) -> Verdict:
+        refused = self.checks_2_to_4(doc)
+        if refused:
+            return refused
+        if doc["expires"] <= self.clock():
+            return Verdict.refuse("expires is in the past", "§3 seal_to")
+        o, refused = self.opened(doc)
+        if refused:
+            return refused
+        try:
+            refused = self.limits(doc, sealing=True)
+            if refused:
+                return refused
+            m1 = self.crypto.seal_to(o, doc["recipient_k1"], doc["expires"], doc["op"])
+            return self.done(doc, "seal_to", v=1, m1=m1)
+        finally:
+            scrub(o.vault_key)
+
+
+__all__ = ["KMS", "MAX_BODY", "SKEW", "canonical"]
diff --git a/sharness_ai/kms/__init__.py b/sharness_ai/kms/__init__.py
