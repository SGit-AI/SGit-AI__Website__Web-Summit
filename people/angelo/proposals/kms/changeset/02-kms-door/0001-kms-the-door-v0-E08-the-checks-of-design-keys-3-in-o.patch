+  {"method": "POST", "path": "/v0/destroy", "op": "destroy", "callers": ["launcher"], "body": "{}"}
+ ],
+ "always": ["GET /v0/hello", "GET /v0/policy", "GET /v0/log (the launcher only)"],
+ "checks": ["1 peer role", "2 sig (when an auth key is bound)", "3 ts within 60 s, nonce unseen", "4 policy hash, a row allows op for vault_id", "5 open sealed", "6 derive, scrub", "7 limits", "8 audit"],
+ "verdicts": {"200": "done", "400": "not the schema", "403": "refused, with the check and the row", "409": "no identity, or one already", "410": "destroyed", "413": "body over 16 KiB", "501": "no cryptography backend"},
