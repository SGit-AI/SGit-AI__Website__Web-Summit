index 0000000..fcd57f8
--- /dev/null
+++ b/sharness_ai/kms/__init__.py
@@ -0,0 +1,13 @@
+"""sharness.kms: where a secret lives (E08, v0). A door on the door kit: `init`, `GET /v0/identity`,
+`GET /v0/policy`, `POST /v0/unwrap`, `POST /v0/seal_to`, `destroy`, with the checks of
+sharness.ai/design/keys §3 in their order. Keys never leave: an unwrap answers only an envelope
+sealed to the caller's one-time key.
+
+Status: proposed (vault.kms@PrompTugal.angelo's changeset, piece 2a). The door logic runs; the
+cryptography is a backend (`Crypto`), and the only one here is `NoCrypto`, which refuses with 501:
+the design's envelope needs AES-256-GCM, which neither the standard library nor the openssl 3.0
+command line offers. Choosing a backend is the open decision (README of the piece)."""
+from sharness_ai.kms.Crypto import Crypto, CryptoRefusal, NoCrypto, Opened
+from sharness_ai.kms.KMS import KMS
+
+__all__ = ["Crypto", "CryptoRefusal", "KMS", "NoCrypto", "Opened"]
diff --git a/tests/unit/kms/test_kms.py b/tests/unit/kms/test_kms.py
