+"""sharness.kms v0 (piece 2a of the kms changeset): one test per check of design/keys §3, each refused with
+its verdict; unwrap answers only an envelope and never a clear key; a replayed nonce is refused; the vault key
+is zeroed; the audit line holds no secret. The cryptography is a test backend (`Fake`) defined here: it proves
+the door, not the primitives. Every key and identifier is made up inside the test and discarded."""
+import base64
+import hashlib
+import hmac
+import json
+import secrets
+import shutil
+import time
+
+import pytest
+
+from sharness_ai.door import Client, Session
+from sharness_ai.kms import KMS, CryptoRefusal, NoCrypto, Opened
+from sharness_ai.kms.Crypto import Crypto
+from sharness_ai.kms.KMS import MAX_BODY, canonical
+from sharness_ai.policy import policy_hash
+
+NOW = 1_800_000_000
+AGENT, VAULT = "agent-a", "vault-1"
+FILES = {"read": [], "write": [], "exec": []}
+
+
+def row(**kw):
+    return dict({"agent": AGENT, "vault_id": VAULT, "ops": ["read", "write"], "max_uses": 3, "until": NOW + 3600}, **kw)
+
+
+def policy(*rows):
+    return {"pbp": 1, "id": "kms-test", "network": "none", "files": dict(FILES), "kms": list(rows) or [row()]}
+
+
+def ts(offset=0):
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(NOW + offset))
+
+
+class Fake(Crypto):
+    """A test backend: a "sealed" key is base64 JSON naming its recipient; keys are HMACs. Not cryptography."""
+    name = "fake"
+
+    def __init__(self):
+        self.ident, self.handed, self.plains, self.scrubbed = None, [], [], False
+        self.vault_key = secrets.token_bytes(32)           # made here, never written anywhere
+
+    def identity(self):
+        return self.ident
+
+    def make_identity(self):
+        self.ident = {"k1": "k1-" + secrets.token_hex(8), "record_fp": "sha256:" + secrets.token_hex(8), "enc_fp": "sha256:" + secrets.token_hex(8)}
+        return self.ident
+
+    def seal(self, to=None, vault_id=VAULT, expires=NOW + 600, sender="sha256:" + "a" * 16):
+        doc = {"to": to or self.ident["record_fp"], "vault_id": vault_id, "key": self.vault_key.hex(), "from": sender, "expires": expires}
+        return base64.b64encode(json.dumps(doc).encode()).decode()
+
+    def verify(self, auth_pub, message, sig):
+        return hmac.compare_digest(sig, base64.b64encode(hmac.new(auth_pub.encode(), message, hashlib.sha256).digest()).decode())
+
+    def open(self, sealed, pins):
+        doc = json.loads(base64.b64decode(sealed))
+        if doc["to"] != self.ident["record_fp"]:
+            raise CryptoRefusal("not addressed to this kms")
+        if doc["from"] not in pins.get("senders", []):
+            raise CryptoRefusal("the sender is not pinned")
+        key = bytearray(bytes.fromhex(doc["key"]))
+        self.handed.append(key)
+        return Opened(doc["vault_id"], key, doc["from"], doc["expires"])
+
+    def derive(self, opened, op):
+        out = {"read_key": bytearray(hmac.new(bytes(opened.vault_key), b"read", hashlib.sha256).digest())}
+        if op == "write":
+            out["write_key"] = bytearray(hmac.new(bytes(opened.vault_key), b"write", hashlib.sha256).digest())
+        return out
+
+    def seal_to_eph(self, plain, eph_pub, nonce, info, aad):
+        self.plains.append(bytes(plain))                      # the test reads what would have been sealed
+        return "env-" + hashlib.sha256(bytes(plain) + aad).hexdigest()
+
+    def seal_to(self, opened, recipient_k1, expires, op):
+        return "m1-" + hashlib.sha256(recipient_k1.encode() + op.encode()).hexdigest()
+
+    def scrub(self):
+        self.scrubbed, self.ident = True, None
+
+
+def _kms():
+    return make()
+
+
+kms = pytest.fixture(_kms, name="kms")          # a fresh kms with the test backend, per test
+
+
+def make(pol=None, approve=None, crypto=None, agent=AGENT, init=True):
+    crypto = crypto or Fake()
+    k = KMS(None, pol or policy(), agent, crypto=crypto, approve=approve, pins={"senders": ["sha256:" + "a" * 16]},
+            clock=lambda: NOW)
+    if init and isinstance(crypto, Fake):
+        crypto.make_identity()
+    return k
+
+
+def unwrap_doc(k, **kw):
+    d = {"v": 1, "op": "read", "sealed": k.crypto.seal() if isinstance(k.crypto, Fake) else "m1.x", "vault_id": VAULT,
+         "eph_pub": base64.b64encode(secrets.token_bytes(91)).decode(), "nonce": base64.b64encode(secrets.token_bytes(16)).decode(),
+         "ts": ts(), "policy_hash": policy_hash(k.policy)}
+    d.update(kw)
+    return {k2: v for k2, v in d.items() if v is not None}
+
+
+def call(k, path, doc=None, peer="net", method="POST", raw=None):
+    body = raw if raw is not None else (json.dumps(doc).encode() if doc is not None else b"")
+    v = k.dispatch(peer, method, path, body)
+    return v
+
+
+class Test_Check_1_The_Peer:
+    def test_unwrap_is_net_s_only(self, kms):
+        v = call(kms, "/v0/unwrap", unwrap_doc(kms), peer="llm")
+        assert v.status == 403 and v.row == "check 1: the peer role"
+
+    def test_the_app_never_reaches_the_kms(self, kms):
+        v = call(kms, "/v0/unwrap", unwrap_doc(kms), peer="app")
+        assert v.status == 403 and "edge app->kms" in v.reason
+
+    def test_init_and_destroy_are_the_launcher_s(self, kms):
+        for path in ("/v0/init", "/v0/destroy"):
+            assert call(kms, path, {}, peer="net").row == "check 1: the peer role"
+
+
+class Test_Schema:
+    @pytest.mark.parametrize("change", [{"vault_id": None}, {"extra": 1}, {"v": 2}, {"v": True}, {"op": "sign"},
+                                        {"nonce": base64.b64encode(b"short").decode()}, {"eph_pub": "not base64!"},
+                                        {"ts": "yesterday"}, {"sig": "%%%"}])
+    def test_a_request_outside_the_schema_is_400(self, kms, change):
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms, **change)).status == 400
+
+    def test_not_json_and_too_big(self, kms):
+        assert call(kms, "/v0/unwrap", raw=b"[1]").status == 400
+        assert call(kms, "/v0/unwrap", raw=b"{" + b" " * MAX_BODY + b"}").status == 413
+
+
+class Test_Check_2_The_Signature:
+    def bound(self):
+        k = make(init=False)
+        auth = base64.b64encode(secrets.token_bytes(91)).decode()
+        assert call(k, "/v0/init", {"policy_hash": policy_hash(k.policy), "expires": NOW + 60, "session_auth_pub": auth}, peer="launcher").allowed
+        return k, auth
+
+    def test_a_bound_kms_refuses_an_unsigned_request(self):
+        k, _ = self.bound()
+        assert call(k, "/v0/unwrap", unwrap_doc(k)).row == "check 2: sig"
+
+    def test_a_bound_kms_refuses_a_wrong_signature_and_takes_a_right_one(self):
+        k, auth = self.bound()
+        bad = unwrap_doc(k, sig=base64.b64encode(b"x" * 32).decode())
+        assert call(k, "/v0/unwrap", bad).row == "check 2: sig"
+        d = unwrap_doc(k)
+        d["sig"] = base64.b64encode(hmac.new(auth.encode(), canonical(d), hashlib.sha256).digest()).decode()
+        assert call(k, "/v0/unwrap", d).allowed
+
+
+class Test_Check_3_Time_And_Nonce:
+    @pytest.mark.parametrize("offset", [61, -61])
+    def test_ts_more_than_60_s_away_is_refused(self, kms, offset):
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms, ts=ts(offset))).row == "check 3: ts"
+
+    def test_a_replayed_nonce_is_refused(self, kms):
+        d = unwrap_doc(kms)
+        assert call(kms, "/v0/unwrap", d).allowed
+        v = call(kms, "/v0/unwrap", d)
+        assert not v.allowed and v.row == "check 3: nonce"
+
+    def test_a_nonce_refused_later_on_still_cannot_be_replayed(self, kms):
+        d = unwrap_doc(kms, vault_id="vault-unknown")
+        assert call(kms, "/v0/unwrap", d).row.startswith("check 4")
+        assert call(kms, "/v0/unwrap", d).row == "check 3: nonce"
+
+
+class Test_Check_4_Policy:
+    def test_another_policy_hash_is_refused(self, kms):
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms, policy_hash="sha256:" + "0" * 64)).row == "check 4: the policy hash"
+
+    def test_no_row_for_the_vault_is_refused(self, kms):
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms, vault_id="vault-2")).row.startswith("check 4: no row")
+
+    def test_a_row_of_another_agent_does_not_count(self):
+        k = make(policy(row(agent="agent-b")))
+        assert call(k, "/v0/unwrap", unwrap_doc(k)).row.startswith("check 4: no row")
+
+    def test_an_op_the_row_does_not_allow_is_refused(self):
+        k = make(policy(row(ops=["read"])), approve=lambda *a: True)
+        assert call(k, "/v0/unwrap", unwrap_doc(k, op="write")).row.endswith("ops")
+
+    def test_a_row_past_its_until_is_refused(self):
+        k = make(policy(row(until=NOW)))
+        assert call(k, "/v0/unwrap", unwrap_doc(k)).row.endswith("until")
+
+    def test_invalid_rows_stop_the_kms_from_starting(self):
+        with pytest.raises(ValueError):
+            make(policy(row(ops=["sign"])))
+
+
+class Test_Check_5_Open:
+    def test_a_key_sealed_to_someone_else_is_refused(self, kms):
+        d = unwrap_doc(kms, sealed=kms.crypto.seal(to="sha256:" + "b" * 16))
+        v = call(kms, "/v0/unwrap", d)
+        assert v.row == "check 5: open" and "not addressed" in v.reason
+
+    def test_an_unpinned_sender_is_refused(self, kms):
+        d = unwrap_doc(kms, sealed=kms.crypto.seal(sender="sha256:" + "c" * 16))
+        assert call(kms, "/v0/unwrap", d).row == "check 5: open"
+
+    def test_an_expired_sealed_key_is_refused_and_zeroed(self, kms):
+        d = unwrap_doc(kms, sealed=kms.crypto.seal(expires=NOW))
+        assert call(kms, "/v0/unwrap", d).row == "check 5: expiry"
+        assert not any(kms.crypto.handed[-1])
+
+
+class Test_Check_6_Derive:
+    def test_the_vault_inside_decides(self, kms):
+        k = make(policy(row(), row(vault_id="vault-2")))
+        d = unwrap_doc(k, vault_id="vault-2", sealed=k.crypto.seal(vault_id=VAULT))
+        assert call(k, "/v0/unwrap", d).row == "check 6: vault id"
+
+    def test_read_carries_no_write_key_and_the_vault_key_is_zeroed(self, kms):
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms)).allowed
+        plain = json.loads(kms.crypto.plains[-1])
+        assert set(plain) == {"vault_id", "read_key"}
+        assert not any(kms.crypto.handed[-1])                 # the bytearray the backend handed over is all zeros
+
+
+class Test_Check_7_Limits:
+    def test_max_uses_counts_successes_only(self, kms):
+        call(kms, "/v0/unwrap", unwrap_doc(kms, ts=ts(99)))   # refused at check 3: not counted
+        for _ in range(3):
+            assert call(kms, "/v0/unwrap", unwrap_doc(kms)).allowed
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms)).row.endswith("max_uses")
+
+    def test_write_needs_a_fresh_approval(self):
+        k = make()
+        assert call(k, "/v0/unwrap", unwrap_doc(k, op="write")).row == "check 7: fresh approval"
+        asked = []
+        k = make(approve=lambda *a: asked.append(a) or True)
+        assert call(k, "/v0/unwrap", unwrap_doc(k, op="write")).allowed
+        assert asked == [(AGENT, VAULT, "write")]
+        assert set(json.loads(k.crypto.plains[-1])) == {"vault_id", "read_key", "write_key"}
+
+
+class Test_Check_8_The_Answer_And_The_Audit:
+    def test_unwrap_answers_an_envelope_and_never_a_clear_key(self, kms):
+        v = call(kms, "/v0/unwrap", unwrap_doc(kms))
+        out = json.dumps(v.payload())
+        assert set(v.body) == {"v", "sealed_to_eph", "expires_in"} and v.body["expires_in"] == 300
+        key = kms.crypto.vault_key
+        read_key = hmac.new(key, b"read", hashlib.sha256).digest()
+        for secret in (key, read_key):
+            assert secret.hex() not in out and base64.b64encode(secret).decode() not in out
+
+    def test_the_audit_line_names_op_vault_and_agent_and_holds_no_secret(self, kms):
+        kms.audit.record("net", "POST", "/v0/unwrap", 1, call(kms, "/v0/unwrap", unwrap_doc(kms)))
+        line = kms.audit.dump()[-1]
+        assert line["row"] == f"unwrap read kms[{AGENT}, {VAULT}] use 1"
+        text = json.dumps(line)
+        key = kms.crypto.vault_key
+        assert key.hex() not in text and base64.b64encode(key).decode() not in text
+
+
+class Test_Init_Identity_Destroy_SealTo:
+    def test_init_once_with_our_policy_hash(self):
+        k = make(init=False)
+        assert call(k, "/v0/identity", method="GET", peer="net").status == 409
+        assert call(k, "/v0/init", {"policy_hash": "sha256:x", "expires": NOW}, peer="launcher").row == "check 4: the policy hash"
+        v = call(k, "/v0/init", {"policy_hash": policy_hash(k.policy), "expires": NOW + 60}, peer="launcher")
+        assert v.allowed and set(v.body) == {"k1", "record_fp", "enc_fp"}
+        assert call(k, "/v0/init", {"policy_hash": policy_hash(k.policy), "expires": NOW + 60}, peer="launcher").status == 409
+        assert call(k, "/v0/identity", method="GET", peer="net").body == v.body
+
+    def test_destroy_scrubs_is_idempotent_and_ends_the_kms(self, kms):
+        assert call(kms, "/v0/destroy", {}, peer="launcher").allowed and kms.crypto.scrubbed
+        assert call(kms, "/v0/destroy", {}, peer="launcher").allowed          # idempotent
+        assert call(kms, "/v0/unwrap", unwrap_doc(kms)).status == 410
+
+    def test_seal_to_always_needs_a_fresh_approval(self):
+        def doc(k):
+            d = unwrap_doc(k, recipient_k1="k1-other", expires=NOW + 600)
+            del d["eph_pub"]
+            return d
+        k = make()
+        assert call(k, "/v0/seal_to", doc(k)).row == "check 7: fresh approval"
+        k = make(approve=lambda *a: True)
+        v = call(k, "/v0/seal_to", doc(k))
+        assert v.allowed and v.body["m1"].startswith("m1-") and not any(k.crypto.handed[-1])
+
+
+class Test_No_Backend:
+    def test_without_a_backend_the_checks_still_run_then_501(self):
+        k = make(crypto=NoCrypto())
+        assert call(k, "/v0/identity", method="GET").status == 409
+        assert call(k, "/v0/unwrap", unwrap_doc(k, ts=ts(99))).row == "check 3: ts"       # refused before any cryptography
+        v = call(k, "/v0/unwrap", unwrap_doc(k))
+        assert v.status == 501 and "AES-256-GCM" in v.reason
+        assert call(k, "/v0/init", {"policy_hash": policy_hash(k.policy), "expires": NOW + 60}, peer="launcher").status == 501
+
+
+class Test_Over_Mutual_TLS:
+    pytestmark = pytest.mark.skipif(not shutil.which("openssl"), reason="needs openssl to issue a session")
+
+    def test_net_reaches_the_kms_and_the_app_does_not(self, tmp_path):
+        s = Session.new(str(tmp_path / "s"), ("app", "net", "kms", "launcher"))
+        k = KMS(s, policy(), AGENT)                           # NoCrypto, the real clock
+        port = k.serve(background=True)
+        try:
+            status, data = Client(s, "net", "kms", port).request("GET", "/v0/identity")
+            assert status == 409
+            status, data = Client(s, "app", "kms", port).request("POST", "/v0/unwrap", b"{}")
+            assert status == 403 and "edge app->kms" in data["reason"]
+            status, data = Client(s, "launcher", "kms", port).request("GET", "/v0/hello")
+            assert status == 200 and data["door"] == "sharness.kms" and data["targets"] == {"sharness.kms.none": "live"}
+        finally:
+            k.stop()
