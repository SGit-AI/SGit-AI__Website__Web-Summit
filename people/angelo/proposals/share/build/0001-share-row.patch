+/* share.css: the share row (newsroom/build/features/share.mjs, assets/share/share.js); the look follows "Save for
+ * offline" (an outlined pill); the one filled button is Share where it opens the phone's sheet. designer@ restyles. */
+.share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 12px 0 0; font: 600 13px/1 var(--sans); }
+.share-end { margin: 32px 0 8px; padding-top: 16px; border-top: 1px solid var(--rule-2); }
+.share-head { width: 100%; margin: 0 0 4px; font: 700 15px/1.3 var(--sans); color: var(--ink); }
+.share-list { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.share-list[hidden] { display: none; }
+.share-label { color: var(--ink-3); margin-right: 2px; }
+.share-to, .share-open { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border: 1px solid var(--rule-2); border-radius: var(--radius-pill); background: var(--paper); color: var(--ink); font: inherit; text-decoration: none; cursor: pointer; }
+.share-to:hover, .share-to:focus-visible, .share-open:hover, .share-open:focus-visible { border-color: var(--brand); color: var(--brand); }
+.share-open { background: var(--brand); border-color: var(--brand); color: var(--on-brand, #fff); }
+.share-open:hover, .share-open:focus-visible { color: var(--on-brand, #fff); filter: brightness(1.1); }
+.share-open[hidden], .share-copy[hidden] { display: none; }
+.share-collapsed .share-label { display: none; }
+.share-collapsed .share-list { width: 100%; }
+@media print { .share { display: none; } }
diff --git a/assets/share/share.js b/assets/share/share.js
new file mode 100644
index 0000000..c4bd90f
--- /dev/null
+++ b/assets/share/share.js
@@ -0,0 +1,31 @@
+/* share.js: the share row (newsroom/build/features/share.mjs). The links work without it; this adds the one Share
+ * button (the phone's own share sheet where the browser has one, else it opens the list) and Copy link. Nothing is
+ * loaded or sent: the sheet and the links go only where the reader chooses. */
+(function () {
+    var rows = document.querySelectorAll('.share'); if (!rows.length) return
+    var narrow = window.matchMedia('(max-width: 640px)')
+    function say(r, t) { var s = r.querySelector('.share-said'); if (s) s.textContent = t }
+    function copy(r, b) {
+        var u = r.dataset.url
+        var done = function () { var l = b.querySelector('span'), o = l.textContent; l.textContent = b.dataset.copied; say(r, b.dataset.copied); setTimeout(function () { l.textContent = o }, 2000) }
+        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(u).then(done, function () { prompt('', u) })
+        else prompt('', u)
+    }
+    Array.prototype.forEach.call(rows, function (r) {
+        var open = r.querySelector('.share-open'), list = r.querySelector('.share-list'), c = r.querySelector('.share-copy')
+        if (c) { c.hidden = false; c.addEventListener('click', function () { copy(r, c) }) }
+        function fit() {
+            var collapse = narrow.matches || !!navigator.share
+            r.classList.toggle('share-collapsed', collapse)
+            open.hidden = !collapse
+            if (!collapse) { list.hidden = false; open.setAttribute('aria-expanded', 'false') } else if (open.getAttribute('aria-expanded') !== 'true') list.hidden = true
+        }
+        open.addEventListener('click', function () {
+            if (navigator.share) { navigator.share({ title: r.dataset.title, text: r.dataset.text, url: r.dataset.url }).catch(function () { }); return }
+            var on = open.getAttribute('aria-expanded') !== 'true'
+            open.setAttribute('aria-expanded', on ? 'true' : 'false'); list.hidden = !on
+        })
+        if (narrow.addEventListener) narrow.addEventListener('change', fit)
+        fit()
+    })
+})()
