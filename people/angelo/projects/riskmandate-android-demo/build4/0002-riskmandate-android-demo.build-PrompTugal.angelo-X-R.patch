+        view.watchTouches { downs++ }
+        fun touch(action: Int): Boolean {
+            val t = SystemClock.uptimeMillis()
+            val e = MotionEvent.obtain(t, t, action, 10f, 10f, 0)
+            return view.dispatchTouchEvent(e).also { e.recycle() }
+        }
