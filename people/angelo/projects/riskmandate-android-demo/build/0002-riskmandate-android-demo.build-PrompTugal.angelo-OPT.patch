+++ b/app/src/main/java/ai/riskmandate/app/features/xray/XrayFeature.kt
@@ -10,8 +10,9 @@ import androidx.compose.runtime.Composable
  * Silvio's X-Ray page (web-summit.sgit.ai) as a stand kiosk: full screen, screen on, locked to web-summit.sgit.ai,
  * recovering by itself; staff leave by holding the bottom-start corner for three seconds.
  *
- * Not on the stand-mode visitor list: the page itself can call AI services (openrouter.ai) with a demo key typed
- * on the device, which stand mode's rule keeps away from visitors until security.android decides otherwise.
+ * On the stand-mode visitor list, so stand mode's screen pinning keeps visitors in it. The page itself can call
+ * AI services (openrouter.ai) with a demo key typed on the device: accepted for this feature by a person's decision
+ * recorded with this change, not by the app's own cloud switch (which stays off in stand mode).
  */
 object XrayFeature : Feature {
     override val id = "xray"
diff --git a/app/src/test/java/ai/riskmandate/app/StandVisibilityTest.kt b/app/src/test/java/ai/riskmandate/app/StandVisibilityTest.kt
