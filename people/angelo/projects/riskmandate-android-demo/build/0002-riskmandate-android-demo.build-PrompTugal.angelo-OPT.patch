 .../java/ai/riskmandate/app/features/xray/XrayFeature.kt     | 5 +++--
 app/src/test/java/ai/riskmandate/app/StandVisibilityTest.kt  | 2 ++
 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/ai/riskmandate/app/MainActivity.kt b/app/src/main/java/ai/riskmandate/app/MainActivity.kt
index e84866f..8bc9bd5 100644
--- a/app/src/main/java/ai/riskmandate/app/MainActivity.kt
+++ b/app/src/main/java/ai/riskmandate/app/MainActivity.kt
@@ -121,7 +121,7 @@ fun cloudIsOn(keySet: Boolean, switchOn: Boolean, standOn: Boolean): Boolean = k
  * Workbench, Models), is hidden while stand mode is on, **even when its owner has switched it on**; a new feature is
  * hidden in stand mode until it is added here on purpose (fail closed). Outside stand mode `enabled` decides alone.
  */
-private val STAND_VISITOR_FEATURES = setOf("site", "abpdemo", "mandate", "releases")
+private val STAND_VISITOR_FEATURES = setOf("site", "abpdemo", "mandate", "releases", "xray")
 
 /** Whether the feature may be shown (Home, sidebar, its route) given stand mode. Not about `enabled`. */
 fun featureVisible(id: String, standOn: Boolean): Boolean = !standOn || id in STAND_VISITOR_FEATURES
diff --git a/app/src/main/java/ai/riskmandate/app/features/xray/XrayFeature.kt b/app/src/main/java/ai/riskmandate/app/features/xray/XrayFeature.kt
index 7a99b81..b92de68 100644
