+}
+
+
+/**
+ * The X-Ray page as a stand kiosk: a window over the whole app (so no app chrome), system bars hidden and coming
+ * back hidden after a swipe, the screen kept on, Back doing nothing. Staff leave by holding the bottom-start
+ * corner for [exitHoldMs] and confirming. The page reloads by itself after an error, a stall or a lost network.
+ */
+@Composable
+fun XrayScreen(
+    onExit: () -> Unit,
+    startUrl: String = XrayPolicy.START_URL,
+    exitHoldMs: Long = 3_000,
+    clock: () -> Long = SystemClock::elapsedRealtime,
+    /** False in screenshot tests: Robolectric draws no web content. */
+    showWebView: Boolean = true,
+    /** For tests: start with the offline cover showing. */
+    startFailed: Boolean = false,
+) {
+    Dialog(
+        onDismissRequest = {},
+        properties = DialogProperties(
+            dismissOnBackPress = false,
+            dismissOnClickOutside = false,
+            usePlatformDefaultWidth = false,
+            decorFitsSystemWindows = false,
+        ),
+    ) {
+        KioskWindow()
+        XrayKiosk(onExit, startUrl, exitHoldMs, clock, showWebView, startFailed)
+    }
+}
+
+/** Full screen for the dialog's window: whole display, no dim, bars hidden (immersive sticky), screen kept on. */
+@Composable
+private fun KioskWindow() {
+    val view = LocalView.current
+    val window = (view.parent as? DialogWindowProvider)?.window
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    DisposableEffect(window, lifecycle) {
+        fun hideBars() {
+            val w = window ?: return
+            WindowCompat.getInsetsController(w, w.decorView).apply {
+                systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+                hide(WindowInsetsCompat.Type.systemBars())
+            }
+        }
+        window?.apply {
+            setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT)
+            clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
+            addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                attributes = attributes.apply {
+                    layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
+                }
+            }
+        }
+        hideBars()
+        // Coming back to the app (after Home or Recents): hidden again.
+        val observer = LifecycleEventObserver { _, event -> if (event == Lifecycle.Event.ON_RESUME) hideBars() }
+        lifecycle.addObserver(observer)
+        onDispose {
+            lifecycle.removeObserver(observer)
+            window?.clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        }
+    }
+}
+
+/** The kiosk's content: the WebView, the cover while it recovers, the staff corner and the exit confirmation. */
+@Composable
+internal fun XrayKiosk(
+    onExit: () -> Unit,
+    startUrl: String,
+    exitHoldMs: Long,
+    clock: () -> Long,
+    showWebView: Boolean,
+    startFailed: Boolean,
+) {
+    val context = LocalContext.current
+    val watchdog = remember { XrayWatchdog().also { if (startFailed) it.onMainFrameError(clock()) } }
+    var cover by remember { mutableStateOf(watchdog.coverShown) }
+    var webView by remember { mutableStateOf<WebView?>(null) }
+    var webViewKey by remember { mutableIntStateOf(0) }
+    var askExit by remember { mutableStateOf(false) }
+
+    fun sync() { cover = watchdog.coverShown }
+    fun reload() {
+        webView?.loadUrl(startUrl)
+        sync()
+    }
+    val currentReload by rememberUpdatedState(::reload)
+
+    // Every 5 s: a stalled load or a failed page whose retry time has come is reloaded.
+    LaunchedEffect(Unit) {
+        while (true) {
+            delay(5_000)
+            if (watchdog.tick(clock()) == XrayAction.RELOAD) currentReload()
+            sync()
+        }
+    }
+    // The network came back: reload at once if the page had failed.
+    DisposableEffect(Unit) {
+        val unregister = watchNetwork(context) { if (watchdog.onNetworkAvailable(clock()) == XrayAction.RELOAD) currentReload() }
+        onDispose(unregister)
+    }
+
+    // The theme's paper behind the page and the cover (colours come from Theme.kt only).
+    val paper = Pt.colors.paper
+    Box(Modifier.fillMaxSize().background(paper)) {
+        if (showWebView) {
+            key(webViewKey) {
+                AndroidView(
+                    factory = { c ->
+                        WebView(c).apply {
+                            applyXraySettings()
+                            setBackgroundColor(paper.toArgb())
+                            contentDescription = c.getString(R.string.feature_xray_webview_description)
+                            webViewClient = XrayWebViewClient(
+                                onStarted = { watchdog.onLoadStarted(clock()); sync() },
+                                onFinished = { failed -> watchdog.onLoadFinished(clock(), failed); sync() },
+                                onMainFrameError = { watchdog.onMainFrameError(clock()); sync() },
+                                onRenderGone = {
+                                    // A new WebView (and renderer) on the next composition; the old one is released below.
+                                    webView = null
+                                    watchdog.onMainFrameError(clock())
+                                    sync()
+                                    webViewKey++
+                                },
+                            )
+                            webView = this
+                            watchdog.onLoadStarted(clock())
+                            loadUrl(startUrl)
+                        }
+                    },
+                    onRelease = { it.stopLoading(); it.destroy() },
+                    modifier = Modifier.fillMaxSize().testTag(XrayTags.WEBVIEW),
+                )
+            }
+        }
+        if (cover) Cover()
+        StaffCorner(exitHoldMs, Modifier.align(Alignment.BottomStart)) { askExit = true }
+    }
+
+    if (askExit) {
+        AlertDialog(
+            onDismissRequest = { askExit = false },
+            modifier = Modifier.testTag(XrayTags.EXIT_DIALOG),
+            title = { Text(stringResource(R.string.feature_xray_exit_title)) },
+            text = { Text(stringResource(R.string.feature_xray_exit_body)) },
+            confirmButton = {
+                TextButton(onClick = { askExit = false; onExit() }, modifier = Modifier.testTag(XrayTags.EXIT_LEAVE)) {
+                    Text(stringResource(R.string.feature_xray_exit_leave))
+                }
+            },
+            dismissButton = {
+                Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                    TextButton(onClick = { askExit = false; reload() }, modifier = Modifier.testTag(XrayTags.EXIT_RELOAD)) {
+                        Text(stringResource(R.string.feature_xray_exit_reload))
+                    }
+                    TextButton(onClick = { askExit = false }, modifier = Modifier.testTag(XrayTags.EXIT_STAY)) {
+                        Text(stringResource(R.string.feature_xray_exit_stay))
+                    }
+                }
+            },
+        )
+    }
+}
+
+/** A calm cover while the page is away: no error text from WebView, just that it is coming back. */
+@Composable
+private fun Cover() {
+    Box(Modifier.fillMaxSize().background(Pt.colors.paper).testTag(XrayTags.COVER), contentAlignment = Alignment.Center) {
+        Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.widthIn(max = 520.dp).padding(32.dp)) {
+            Text(
+                stringResource(R.string.feature_xray_cover_title),
+                style = MaterialTheme.typography.headlineSmall,
+                color = Pt.colors.ink,
+                textAlign = TextAlign.Center,
+            )
+            Text(
+                stringResource(R.string.feature_xray_cover_body),
+                style = MaterialTheme.typography.bodyLarge,
+                color = Pt.colors.muted,
+                textAlign = TextAlign.Center,
+                modifier = Modifier.padding(top = 12.dp),
+            )
+        }
+    }
+}
+
+/** An invisible 56 dp corner: held for [holdMs], it asks to leave. A tap does nothing. */
+@Composable
+private fun StaffCorner(holdMs: Long, modifier: Modifier = Modifier, onHeld: () -> Unit) {
+    val description = stringResource(R.string.feature_xray_staff_corner)
+    val held by rememberUpdatedState(onHeld)
+    Box(
+        modifier
+            .size(56.dp)
+            .testTag(XrayTags.STAFF_CORNER)
+            .semantics { contentDescription = description }
+            .pointerInput(holdMs) {
+                awaitEachGesture {
+                    awaitFirstDown(requireUnconsumed = false)
+                    val up = withTimeoutOrNull(holdMs) { waitForUpOrCancellation() }
+                    if (up == null) held()
+                }
+            },
+    )
+}
+
+/** Calls [onAvailable] on the main thread whenever the default network becomes available. Returns the unregister. */
+private fun watchNetwork(context: Context, onAvailable: () -> Unit): () -> Unit {
+    val cm = context.getSystemService(ConnectivityManager::class.java) ?: return {}
+    val main = Handler(Looper.getMainLooper())
+    var active = true
+    val callback = object : ConnectivityManager.NetworkCallback() {
+        override fun onAvailable(network: Network) {
+            main.post { if (active) onAvailable() }
+        }
+    }
+    try {
+        cm.registerDefaultNetworkCallback(callback)
+    } catch (e: RuntimeException) {
+        return {}
+    }
+    return {
+        active = false
+        try { cm.unregisterNetworkCallback(callback) } catch (e: RuntimeException) { /* already gone */ }
+    }
+}
diff --git a/app/src/main/java/ai/riskmandate/app/features/xray/XrayWebView.kt b/app/src/main/java/ai/riskmandate/app/features/xray/XrayWebView.kt
new file mode 100644
index 0000000..10a7e04
--- /dev/null
+++ b/app/src/main/java/ai/riskmandate/app/features/xray/XrayWebView.kt
@@ -0,0 +1,157 @@
+package ai.riskmandate.app.features.xray
+
+import android.annotation.SuppressLint
+import android.graphics.Bitmap
+import android.net.Uri
+import android.net.http.SslError
+import android.os.Message
+import android.webkit.CookieManager
+import android.webkit.GeolocationPermissions
+import android.webkit.PermissionRequest
+import android.webkit.RenderProcessGoneDetail
+import android.webkit.SslErrorHandler
+import android.webkit.ValueCallback
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceError
+import android.webkit.WebResourceRequest
+import android.webkit.WebResourceResponse
+import android.webkit.WebSettings
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import androidx.webkit.ProfileStore
+import androidx.webkit.WebViewCompat
+import androidx.webkit.WebViewFeature
+import java.io.ByteArrayInputStream
+
+/**
+ * The kiosk's WebView client: main-frame pages only on web-summit.sgit.ai ([XrayPolicy.allowPage]), anything else
+ * ignored (never handed to a browser: that would leave the kiosk); sub-resources off [XrayPolicy.SUBRESOURCE_HOSTS]
+ * refused; load progress reported to the watchdog.
+ */
+class XrayWebViewClient(
+    private val onStarted: () -> Unit,
+    private val onFinished: (failedMeanwhile: Boolean) -> Unit,
+    private val onMainFrameError: () -> Unit,
+    private val onRenderGone: () -> Unit,
+) : WebViewClient() {
+    private var failedThisLoad = false
+
+    /** True cancels: a page off web-summit.sgit.ai, or a frame to a host the page may not fetch from. */
+    override fun shouldOverrideUrlLoading(view: WebView, request: WebResourceRequest): Boolean {
+        val url = request.url.toString()
+        return if (request.isForMainFrame) !XrayPolicy.allowPage(url) else XrayPolicy.blockSubresource(url)
+    }
+
+    override fun shouldInterceptRequest(view: WebView, request: WebResourceRequest): WebResourceResponse? {
+        val url = request.url.toString()
+        if (request.isForMainFrame && !XrayPolicy.allowPage(url)) return refused()
+        if (XrayPolicy.blockSubresource(url)) return refused()
+        return null
+    }
+
+    override fun onPageStarted(view: WebView, url: String?, favicon: Bitmap?) {
+        failedThisLoad = false
+        onStarted()
+    }
+
+    override fun onPageFinished(view: WebView, url: String?) = onFinished(failedThisLoad)
+
+    override fun onReceivedError(view: WebView, request: WebResourceRequest, error: WebResourceError) {
+        if (request.isForMainFrame) fail()
+    }
+
+    override fun onReceivedHttpError(view: WebView, request: WebResourceRequest, errorResponse: WebResourceResponse) {
+        // A 5xx on the page itself (not on one of its fetches: the vault's 507s are the page's business).
+        if (request.isForMainFrame && errorResponse.statusCode >= 500) fail()
+    }
+
+    /** Never proceed past a certificate error. */
+    override fun onReceivedSslError(view: WebView, handler: SslErrorHandler, error: SslError) {
+        handler.cancel()
+        fail()
+    }
+
+    /** The renderer died: the screen builds a new WebView (returning false would kill the whole app). */
+    override fun onRenderProcessGone(view: WebView, detail: RenderProcessGoneDetail): Boolean {
+        onRenderGone()
+        return true
+    }
+
+    private fun fail() {
+        failedThisLoad = true
+        onMainFrameError()
+    }
+
+    private fun refused() =
+        WebResourceResponse("text/plain", "utf-8", 403, "Blocked", mapOf("Cache-Control" to "no-store"), ByteArrayInputStream(ByteArray(0)))
+}
+
+/**
+ * Denies what a page can ask for (camera, microphone, location, files, new windows). JavaScript alert and confirm
+ * keep WebView's own dialogs (the page asks `confirm` before some actions), which a WebChromeClient enables.
+ */
+class XrayChromeClient : WebChromeClient() {
+    override fun onPermissionRequest(request: PermissionRequest) = request.deny()
+
+    override fun onGeolocationPermissionsShowPrompt(origin: String?, callback: GeolocationPermissions.Callback) =
+        callback.invoke(origin, false, false)
+
+    override fun onShowFileChooser(webView: WebView?, filePathCallback: ValueCallback<Array<Uri>>?, fileChooserParams: FileChooserParams?): Boolean {
+        filePathCallback?.onReceiveValue(null)
+        return true
+    }
+
+    override fun onCreateWindow(view: WebView?, isDialog: Boolean, isUserGesture: Boolean, resultMsg: Message?): Boolean = false
+}
+
+/** The WebView profile the kiosk uses, so the site screen's wipe of the default profile never clears the demo key. */
+const val XRAY_PROFILE = "xray"
+
+/**
+ * Settings for the kiosk. Unlike the site screen, the page's state is **kept**: DOM storage on and first-party
+ * cookies accepted and never cleared, so the demo key a staff member unlocks once (Silvio's page asks a new
+ * device for it) stays across reloads and app restarts. Where WebView supports profiles (WebView 110+), the
+ * kiosk has its own profile; otherwise it shares the default one, and opening the site screen clears it.
+ * Otherwise as locked down as the site screen: no file or content access, Safe Browsing on, no mixed content,
+ * no third-party cookies, no JavaScript interface, no downloads, no new windows, remote debugging off.
+ *
+ * Returns true when the kiosk has its own profile.
+ */
+@SuppressLint("SetJavaScriptEnabled")
+fun WebView.applyXraySettings(): Boolean {
+    // Must come before anything is loaded in this WebView.
+    var profileCookies: CookieManager? = null
+    try {
+        if (WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
+            val profile = ProfileStore.getInstance().getOrCreateProfile(XRAY_PROFILE)
+            WebViewCompat.setProfile(this, XRAY_PROFILE)
+            profileCookies = profile.cookieManager
+        }
+    } catch (e: RuntimeException) {
+        profileCookies = null // no own profile: the default one
+    }
+    val ownProfile = profileCookies != null
+    with(settings) {
+        javaScriptEnabled = true
+        domStorageEnabled = true
+        allowFileAccess = false
+        allowContentAccess = false
+        @Suppress("DEPRECATION")
+        allowFileAccessFromFileURLs = false
+        @Suppress("DEPRECATION")
+        allowUniversalAccessFromFileURLs = false
+        mixedContentMode = WebSettings.MIXED_CONTENT_NEVER_ALLOW
+        safeBrowsingEnabled = true
+        javaScriptCanOpenWindowsAutomatically = false
+        setSupportMultipleWindows(false)
+        setGeolocationEnabled(false)
+        mediaPlaybackRequiresUserGesture = true
+        cacheMode = WebSettings.LOAD_DEFAULT
+    }
+    webChromeClient = XrayChromeClient()
+    (profileCookies ?: CookieManager.getInstance()).apply {
+        setAcceptCookie(true)
+        setAcceptThirdPartyCookies(this@applyXraySettings, false)
+    }
+    return ownProfile
+}
