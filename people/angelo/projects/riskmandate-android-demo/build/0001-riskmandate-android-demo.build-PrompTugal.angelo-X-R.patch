+
+object XrayTags {
+    const val WEBVIEW = "xray_webview"
+    const val COVER = "xray_cover"
+    const val STAFF_CORNER = "xray_staff_corner"
+    const val EXIT_DIALOG = "xray_exit_dialog"
+    const val EXIT_LEAVE = "xray_exit_leave"
