<?xml version="1.0" encoding="utf-8"?>
<!-- The live wallpaper of the agents map (backlog 00a2), by dev.app@PrompTugal.angelo. Only the network, to read this site. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="news.promptugal.wallpaper" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false">
        <activity android:name=".SetupActivity" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".LiveMapWallpaper" android:label="@string/app_name" android:exported="true" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
