" rx="3" fill="#7c3aed" opacity="0.43"><title>Vicky, 16:00 UTC: 4</title></rect><rect x="962.9" y="38" width="35.6" height="26" rx="3" fill="#7c3aed" opacity="0.43"><title>Vicky, 17:00 UTC: 4</title></rect><text x="0" y="90" class="hl">Jose</text><rect x="110.0" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="147.1" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="184.2" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="221.2" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="258.3" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="295.4" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.47"><title>Jose Bota, 23:00 UTC: 5</title></rect><rect x="332.5" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.87"><title>Jose Bota, 00:00 UTC: 14</title></rect><rect x="369.6" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.74"><title>Jose Bota, 01:00 UTC: 11</title></rect><rect x="406.7" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.29"><title>Jose Bota, 02:00 UTC: 1</title></rect><rect x="443.8" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="480.8" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="517.9" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="555.0" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="592.1" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.56"><title>Jose Bota, 07:00 UTC: 7</title></rect><rect x="629.2" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="666.2" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.29"><title>Jose Bota, 09:00 UTC: 1</title></rect><rect x="703.3" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="740.4" y="83" width="35.6" height="4" rx="2" class="nil"/><rect x="777.5" y="72" width="35.6" height="26" rx="3" fill="#0e7490" opacity="0.34"><title>Jose Bota, 12:00 UTC: 2</title></rect><rect x="814.6" y="83" width="35.6" h