<style>
.deck{--paper:var(--surface);font-size:17px}.deck *{box-sizing:border-box}
.deck .slide{position:relative;aspect-ratio:16/9;background:var(--paper);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:2.2em 2.6em;margin:0 0 1.6em;overflow:hidden;display:flex;flex-direction:column}
.deck .slide h1{font:800 3.4em/1.05 Georgia,serif;margin:.4em 0}.deck .slide h2{font:700 1.75em/1.2 Georgia,serif;margin:0 0 1em;border:0;padding:0}
.deck .slide-n{position:absolute;right:1em;bottom:.6em;font:600 .75em ui-monospace,monospace;color:var(--ink-2)}
.deck .kick{font:700 .8em ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.deck .big{font-size:1.25em}
.deck .cover{display:flex;flex-direction:column;justify-content:center;height:100%}
.deck .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:.8em;margin:1em 0}.deck .tiles div{border:1px solid var(--line);border-radius:12px;padding:.8em 1em;color:var(--ink-2);font-size:.9em;background:var(--surface-2)}.deck .tiles b{display:block;font:800 2.3em/1.1 Georgia,serif;color:var(--ink)}
.deck .cap{color:var(--ink-2);font-size:.9em;margin:.4em 0 0}.deck ul,.deck ol{margin:.6em 0 0;padding-left:1.2em;font-size:1em}.deck li{margin:.3em 0}
.deck .two{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr);gap:1em;min-height:0;flex:1 1 0}.deck .shot{margin:0;display:flex;flex-direction:column;min-height:0;height:100%}
.deck .shot img{width:100%;flex:1 1 0;min-height:0;object-fit:cover;object-position:top;border:1px solid var(--line);border-radius:10px}.deck .shot figcaption{font-size:.8em;color:var(--ink-2);margin-top:.3em}
.deck .two+ul{font-size:.82em;margin-top:.5em;flex:none}
.deck .heat{width:100%}.deck .heat .hl{font:600 14px system-ui;fill:var(--ink)}.deck .heat .hx{font:11px ui-monospace,monospace;fill:var(--ink-2)}.deck .heat .nil{fill:var(--line)}
.deck .bars .b{display:grid;grid-template-columns:110px 1fr 40px;gap:.8em;align-items:center;margin:.35em 0}.deck .bars i{display:block;height:20px;border-radius:5px}
.deck .dotrow{display:grid;grid-template-columns:90px 22em 1fr;gap:.6em;align-items:center;margin:.5em 0}.deck .dotrow i{display:inline-block;width:22px;height:22px;border-radius:6px;margin-right:4px}.deck .dotrow em{font-style:normal;color:var(--ink-2);font-size:.85em}
.deck .keys{display:grid;grid-template-columns:repeat(4,1fr);gap:1em;margin:1em 0}.deck .keys .k{border:2px dashed var(--line-2);border-radius:14px;padding:1em;opacity:.6}.deck .keys .k.on{border:2px solid var(--c);opacity:1}.deck .keys b{display:block;font-size:1.3em}.deck .keys span{color:var(--ink-2)}
.deck .raci{border-collapse:collapse;font-size:.95em;width:100%}.deck .raci td,.deck .raci th{border:1px solid var(--line);padding:.35em .5em;text-align:center}.deck .raci td:first-child{text-align:left}
.deck .rA{background:var(--accent);color:var(--accent-ink);font-weight:800}.deck .rR{background:var(--accent-soft);font-weight:700}.deck .rC{color:var(--ink)}.deck .rI{color:var(--ink-2)}
.deck .three{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;min-height:0;flex:1 1 0;overflow:hidden}.deck .three h3{margin:0 0 .3em;font-size:1em}.deck .pts{list-style:none;padding:0;margin:0;font-size:.72em}.deck .pts li{margin:.25em 0;padding-left:.5em;border-left:4px solid var(--line-2)}.deck .pts li.late{border-color:var(--warm)}.deck .pts li.today{border-color:var(--accent)}.deck .pts span{display:block;color:var(--ink-2)}.deck .decide li{font-size:1.1em;margin:.5em 0}
.deck.one .slide{display:none;margin:0}.deck.one .slide.current{display:flex}.deck.one>:not(.slide):not(.deck-bar){display:none}
.deck .deck-bar{display:flex;align-items:center;gap:.5em;flex-wrap:wrap;margin:.8em 0 1.2em}.deck .deck-bar button,.deck .deck-pdf{font:inherit;font-size:.9em;font-weight:700;padding:.45em .9em;border-radius:10px;border:1px solid var(--line-2);background:var(--surface);color:var(--ink);cursor:pointer;text-decoration:none}
.deck .deck-bar [data-prev],.deck .deck-bar [data-next]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);min-width:3em}.deck .deck-bar button:disabled{opacity:.35;cursor:default}
.deck .deck-pos{font:600 .9em ui-monospace,monospace;min-width:4.5em;text-align:center}.deck .deck-gap{flex:1}
.deck.all .deck-bar{position:sticky;bottom:0;background:var(--bg);padding:.5em 0;margin:0}
.deck.full,.deck:fullscreen{position:fixed;inset:0;z-index:1000;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1vh 2vw;font-size:clamp(14px,1.45vw,26px)}
.deck.full .slide.current,.deck:fullscreen .slide.current{width:min(96vw,150vh)}.deck.full .deck-bar,.deck:fullscreen .deck-bar{width:min(96vw,150vh);margin:.6em 0 0}
html.deck-on body{overflow:hidden}
@media (max-width:760px){.deck .slide{aspect-ratio:auto;min-height:70vh;padding:1.1em;overflow:visible}.deck .two,.deck .tiles,.deck .keys,.deck .three{grid-template-columns:1fr}.deck .two{flex:none}.deck .shot img{flex:none;height:auto;max-height:45vh}
.deck .slide h1{font-size:2.2em}.deck .slide h2{font-size:1.35em}.deck .dotrow{grid-template-columns:5em 1fr}.deck .dotrow em{grid-column:1/-1}.deck .raci{font-size:.75em}.deck .bars .b{grid-template-columns:5em 1fr 2.5em}.deck .three{flex:none;overflow:visible}.deck .deck-gap{display:none}}
@media print{.deck .deck-bar{display:none}}
</style>
<div class="deck one" data-pdf="../../../assets/shows/2026-11-04-1800/deck.pdf"><section class="slide" aria-label="cover"><div class="cover"><p class="kick">RiskMandate · Web Summit Lisbon 2026 · the team</p><h1>The 18:00 debrief</h1>
<p class="big">Wednesday 4 November 2026 · 18:00 Lisbon · <b>5 days</b> to opening night (Mon 9 Nov), our stand Thu 12 Nov</p>
<div class="tiles"><div><b>248</b>agent commits since yesterday's 18:00</div><div><b>175</b>releases</div><div><b>34</b>agents at work today</div><div><b>5 of 7</b>people with a site key</div></div>
<p class="cap">Built from the repository at 17:35 UTC. Nobody was asked what they did.</p></div></section><section class="slide" aria-label="Urgent, late and logistics"><h2>Open points first: urgent, late, logistics</h2><div class="three"><div><h3>Late (24)</h3><ul class="pts"><li class="late"><b>WS-50</b> The journalist&#x27;s report every two hours, and a daily newsletter <span>from Mon 2 Nov · dinis · open</span></li><li class="late"><b>WS-56</b> The shirt messages: RiskMandate openers <span>Mon 2 Nov · sarah, nimay, indi · open</span></li><li class="late"><b>WS-62</b> Vote on the design <span>Mon 2 Nov, 16:00 · everyone · open</span></li><li class="late"><b>WS-63</b> The final design set, approved, and the print files <span>Mon 2 Nov, 20:00 · sarah, dinis · in progress</span></li><li class="late"><b>WS-01</b> Get to L1: a dedicated Claude account for this work <span>Tue 3 Nov · everyone · open</span></li><li class="late"><b>WS-02</b> Get to L2: GitHub, push access to this repository, and an email you can send from <span>Tue 3 Nov · everyone · open</span></li><li class="late"><b>WS-08</b> Fill in your card <span>Tue 3 Nov · everyone · open</span></li><li class="late"><b>WS-09</b> Add everyone&#x27;s GitHub account to the repository <span>Tue 3 Nov · dinis · open</span></li><li class="late"><b>WS-10</b> Workspace email accounts where they are needed <span>Tue 3 Nov · dinis · open</span></li><li class="more">and 15 more on the board</li></ul></div><div><h3>Due today (54)</h3><ul class="pts"><li class="today"><b>WS-03</b> Get to L4: your agents&#x27; keys published, and a dashboard agent <span>Wed 4 Nov · everyone · open</span></li><li class="today"><b>WS-04</b> Get to L4: a Claude session on a schedule <span>Wed 4 Nov · everyone · open</span></li><li class="today"><b>WS-06</b> Make your dashboard yours <span>Wed 4 Nov · everyone · open</span></li><li class="today"><b>WS-108</b> Jose&#x27;s two apps (Hack the Agent, ReachCheck) as the stand demos, if Jose agrees <span>Wed 4 Nov · jose, dinis · picked</span></li><li class="today"><b>WS-109</b> The grant, not the prompt&quot; as the one demo, and its lines for the shirts and the stand <span>Wed 4 Nov · dinis, everyone · open</span></li><li class="today"><b>WS-112</b> Every person&#x27;s conductor briefs its person (people/&lt;id&gt;/briefs/, ack.json), with a review step <span>Wed 4 Nov · everyone · open</span></li><li class="today"><b>WS-114</b> Feedback lanes: a vault per agent, who drains them, and idle runs on the same lanes <span>Wed 4 Nov · dinis · in progress</span></li><li class="today"><b>WS-118</b> The keys page: a status, an expiry and a proof of possession for every key <span>Wed 4 Nov · dinis · open</span></li><li class="today"><b>WS-119</b> The feedback lane is unauthenticated: what it carries is material, and approvals wait for signa <span>Wed 4 Nov · dinis · open</span></li><li class="more">and 45 more</li></ul></div><div><h3>Logistics (15)</h3><ul class="pts"><li class="logi"><b>WS-108</b> Jose&#x27;s two apps (Hack the Agent, ReachCheck) as the stand demos, if Jose agrees <span>Wed 4 Nov · jose, dinis · picked</span></li><li class="logi"><b>WS-109</b> The grant, not the prompt&quot; as the one demo, and its lines for the shirts and the stand <span>Wed 4 Nov · dinis, everyone · open</span></li><li class="logi"><b>WS-113</b> Print files ready for sign-off, and an Official Sign-off on /print/ that everyone signs with th <span>Tue 3 Nov, 16:00 · dinis, everyone · open</span></li><li class="logi"><b>WS-13</b> The merch budget <span>Wed 4 Nov, 12:00 · dinis · open</span></li><li class="logi"><b>WS-142</b> Synthetic users for the business cards: five invented people get a card, scan it and say what t <span>Thu 5 Nov · indi, dinis · open</span></li><li class="logi"><b>WS-144</b> designer@web-summit.indi writes in team/designer/ and content/, and is not in Indi&#x27;s agents.jso <span>Thu 5 Nov · indi · open</span></li><li class="logi"><b>WS-146</b> The /meet/ pages, before the cards are printed: no key box for visitors, a working contact, the <span>Fri 6 Nov · dinis · open</span></li><li class="logi"><b>WS-48</b> Printing and merch logistics <span>Wed 4 Nov · vicky, silvio · open</span></li><li class="logi"><b>WS-54</b> Local Algarve: printing, ads and who can do what <span>Tue 3 Nov · silvio · open</span></li></ul></div></div><p class="cap">From the board at build time: open issues past their due date, due today, and logistics (merch, print, travel, the stand). At Angelo's ask (a signed message, 17:25).</p></section><section class="slide" aria-label="The day, hour by hour"><h2>Who worked when: commits per hour, per person (their agents), since yesterday 18:00</h2><svg viewBox="0 0 1000 234" class="heat" role="img" aria-label="Commits per hour, per person"><text x="0" y="22" class="hl">Dinis</text><rect x="110.0" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.38"><title>Dinis Cruz, 18:00 UTC: 3</title></rect><rect x="147.1" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.29"><title>Dinis Cruz, 19:00 UTC: 1</title></rect><rect x="184.2" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.47"><title>Dinis Cruz, 20:00 UTC: 5</title></rect><rect x="221.2" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.29"><title>Dinis Cruz, 21:00 UTC: 1</title></rect><rect x="258.3" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.38"><title>Dinis Cruz, 22:00 UTC: 3</title></rect><rect x="295.4" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.38"><title>Dinis Cruz, 23:00 UTC: 3</title></rect><rect x="332.5" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.51"><title>Dinis Cruz, 00:00 UTC: 6</title></rect><rect x="369.6" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.29"><title>Dinis Cruz, 01:00 UTC: 1</title></rect><rect x="406.7" y="4" width="35.6" height="26" rx="3" fill="#111827" opacity="0.34"><title>Dinis Cruz, 02:00 UTC: 