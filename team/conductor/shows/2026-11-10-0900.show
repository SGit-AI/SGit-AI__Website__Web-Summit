height="26" rx="3" fill="#0e7490" opacity="0.52"><title>Jose Bota, 07:00 UTC: 4</title></rect><rect x="940.7" y="83" width="57.8" height="4" rx="2" class="nil"/><text x="0" y="124" class="hl">Vicky</text><rect x="110.0" y="106" width="57.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 18:00 UTC: 1</title></rect><rect x="169.3" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="228.7" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="288.0" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="347.3" y="106" width="57.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 22:00 UTC: 1</title></rect><rect x="406.7" y="106" width="57.8" height="26" rx="3" fill="#7c3aed" opacity="0.45"><title>Vicky Wang, 23:00 UTC: 3</title></rect><rect x="466.0" y="106" width="57.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 00:00 UTC: 1</title></rect><rect x="525.3" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="584.7" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="644.0" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="703.3" y="106" width="57.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 04:00 UTC: 1</title></rect><rect x="762.7" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="822.0" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="881.3" y="117" width="57.8" height="4" rx="2" class="nil"/><rect x="940.7" y="117" width="57.8" height="4" rx="2" class="nil"/><text x="0" y="158" class="hl">Indi</text><rect x="110.0" y="140" width="57.8" height="26" rx="3" fill="#c2410c" opacity="0.32"><title>Indi Gupte, 18:00 UTC: 1</title></rect><rect x="169.3" y="140" width="57.8" height="26" rx="3" fill="#c2410c" opacity="0.32"><title>Indi Gupte, 19:00 UTC: 1</title></rect><rect x="228.7" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="288.0" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="347.3" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="406.7" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="466.0" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="525.3" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="584.7" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="644.0" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="703.3" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="762.7" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="822.0" y="151" width="57.8" height="4" rx="2" class="nil"/><rect x="881.3" y="140" width="57.8" height="26" rx="3" fill="#c2410c" opacity="0.32"><title>Indi Gupte, 07:00 UTC: 1</title></rect><rect x="940.7" y="151" width="57.8" height="4" rx="2" class="nil"/><text x="110.0" y="190" class="hx">09 Nov 18:00</text><text x="466.0" y="190" class="hx">10 Nov 00:00</text><text x="822.0" y="190" class="hx">10 Nov 06:00</text></svg><p class="cap">Each square is an hour; darker is more.</p></section><section class="slide" aria-label="The agents"><h2>19 agents did work today; 88 keys on the keys page</h2><div class="dotrow"><span>Silvio</span><span class="ds"><i style="background:#b91c1c" title="conductor@web-summit.silvio"></i><i style="background:#b91c1c" title="crm@web-summit.silvio"></i><i style="background:#b91c1c" title="dashboard@web-summit.silvio"></i><i style="background:#b91c1c" title="dev@web-summit.silvio"></i><i style="background:#b91c1c" title="gamma-ray@web-summit.silvio"></i><i style="background:#b91c1c" title="procurement@web-summit.silvio"></i><i style="background:#b91c1c" title="video@web-summit.silvio"></i></span><em>7: conductor, crm, dashboard, dev, gamma-ray, procurement, video</em></div><div class="dotrow"><span>Dinis</span><span class="ds"><i style="background:#111827" title="conductor@web-summit.dinis"></i><i style="background:#111827" title="journalist@web-summit.dinis"></i></span><em>2: conductor, journalist</em></div><div class="dotrow"><span>Jose</span><span class="ds"><i style="background:#0e7490" title="conductor@web-summit.jose"></i><i style="background:#0e7490" title="dashboard@web-summit.jose"></i><i style="background:#0e7490" title="vault@web-summit.jose"></i><i style="background:#0e7490" title="watcher@web-summit.jose"></i></span><em>4: conductor, dashboard, vault, watcher</em></div><div class="dotrow"><span>Vicky</span><span class="ds"><i style="background:#7c3aed" title="conductor@web-summit.vicky"></i><i style="background:#7c3aed" title="researcher@web-summit.vicky"></i><i style="background:#7c3aed" title="scout@web-summit.vicky"></i></span><em>3: conductor, researcher, scout</em></div><div class="dotrow"><span>Indi</span><span class="ds"><i style="background:#c2410c" title="conductor@web-summit.indi"></i><i style="background:#c2410c" title="conductor-map@web-summit.indi"></i><i style="background:#c2410c" title="prompter@web-summit.indi"></i></span><em>3: conductor, conductor-map, prompter</em></div><p class="cap">One dot per agent that committed under its own name since the last stand-up.</p></section><section class="slide" aria-label="The theme"><h2>One theme: agentic, measured by GAMMA-Ray</h2><ul><li><b>pt.news is the agentic edition:</b> we measure, discuss, document and write stories about agentic AI</li><li><b>GAMMA-Ray launches today:</b> "RiskMandate launches a new way to score companies; we are trying it out at the summit"</li><li><b>The summit is Wednesday for us;</b> today is discovery. Remove blockers: the teams govern well</li><li><b>Since Monday night:</b> a vision, an interview capability (from very noisy audio), the stop and the restart of every team</li></ul></section><section class="slide" aria-label="pt.news"><h2>pt.news, the agentic edition</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/pt-front.jpg" alt="promptugal.news today: the design flip starts now" loading="lazy"><figcaption>promptugal.news today: the design flip starts now</figcaption></figure><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/interview.jpg" alt="The first interview, live: Student Property Network" loading="lazy"><figcaption>The first interview, live: Student Property Network</figcaption></figure></div><ul><li><b>At the top:</b> GAMMA-Ray cards, the leaderboard, the latest rounds</li><li><b>Then:</b> the interviews (two live, more from Indi's team today), materials, contributors</li><li><b>Companies as a graph, not a list;</b> a modern, Portuguese design at the investor decks' quality</li></ul></section><section class="slide" aria-label="GAMMA-Ray"><h2>GAMMA-Ray: Graph-Analyzed Multi-framework Maturity Assessment with Risk-Adjusted Yield</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/gamma-home.jpg" alt="gamma-ray.sgit.ai" loading="lazy"><figcaption>gamma-ray.sgit.ai</figcaption></figure><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/gamma-mashup.jpg" alt="The mashup: eight instruments, read at source" loading="lazy"><figcaption>The mashup: eight instruments, read at source</figcaption></figure></div><ul><li><b>Spectrum:</b> Autonomy, Reach, Control, Openness, four levels each; every rung an achievement</li><li><b>Evidence:</b> captured, hashed, dated; two blind assessors, a challenger, a gate, a person</li><li><b>A report every hour:</b> gamma.studio@ picks a company, maps its agents, people, stories and graph, publishes the card (beta)</li></ul></section><section class="slide" aria-label="The first scans"><h2>Who we scan first</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/gamma-scans.jpg" alt="The scans page" loading="lazy"><figcaption>The scans page</figcaption></figure><div><ul><li><b>Agent products at the summit:</b> Replit, Manus AI, JetBrains, AISLE, GetVocal AI, Emergence, Trent AI, LEGALFLY, CrowdStrike, Cloudflare</li><li><b>The governance side:</b> Airia, Polygraf AI, Descope, 1Password, Delinea, LaunchDarkly, Hexamind, Cisco Outshift</li><li><b>Then</b> the Portuguese cohort, and every company we meet: claim your card</li></ul></div></div></section><section class="slide" aria-label="The app"><h2>The app, on every device</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/pt-app.jpg" alt="The app on the web, pt.news /app/" loading="lazy"><figcaption>The app on the web, pt.news /app/</figcaption></figure><div><ul><li><b>iOS:</b> location and the map, Apple Intelligence over our data, many design rounds; published straight from dev</li><li><b>On the web:</b> in an iPhone or iPad frame, installable, so Android users can use it</li><li><b>devops.ios@:</b> fewer Mac steps per push, faster to TestFlight</li><li><b>pt.news on Android</b> and GCP examples: the Android team</li></ul></div></div></section><section class="slide" aria-label="RiskMandate demos"><h2>RiskMandate demos</h2><ul><li><b>Angelo's team leads:</b> example after example of agent behaviour policies in action; our own ABPs as case studies</li><li><b>Android and iOS tablets match</b> for the demos on Wednesday; the chat is real, not a demo</li><li><b>On the sites:</b> the demos linked at the top, the videos and animations (ruv.sgit, the Ultimate Insider talk)</li></ul></section><section class="slide" aria-label="Ourselves"><h2>We are the case study</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/pipeline.jpg" alt="From a voice brief to TestFlight in 1 h 40" loading="lazy"><figcaption>From a voice brief to TestFlight in 1 h 40</figcaption></figure><figure class="shot"><img src="../../../assets/shows/2026-11-10-0900/collaborators.jpg" alt="Collaborators: Andrew is the first" loading="lazy"><figcaption>Collaborators: Andrew is the first</figcaption></figure></div><ul><li><b>The big stop:</b> 5 conductors to 2 in 5 to 33 minutes; then the restart</li><li><b>Contributors:</b> pt.news/contribute, CC BY 4.0; everyone we meet is a potential contributor</li></ul></section><section class="slide" aria-label="Who takes what"><h2>Who takes what today</h2><ul><li><b>Indi:</b> the apps, the interview pipeline, messaging</li><li><b>Angelo:</b> RiskMandate demos and ABPs in action</li><li><b>Silvio:</b> X-ray at the stand feeding GAMMA-Ray, claim-your-card follow-ups, videos</li><li><b>Vicky:</b> articles from each GAMMA-Ray report and interview</li><li><b>Jose:</b> the launch posts, each card and interview shared with the company tagged</li><li><b>Dinis's agents:</b> gamma-ray@, gamma.studio@, devops.ios@, PrompTugal's team, Android, the main conductor</li></ul></section></div>
