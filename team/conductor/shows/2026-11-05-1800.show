<style>
.deck{--paper:var(--surface);font-size:17px}.deck *{box-sizing:border-box}
.deck .slide{position:relative;aspect-ratio:16/9;background:var(--paper);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:2.2em 2.6em;margin:0 0 1.6em;overflow:hidden;display:flex;flex-direction:column}
.deck .slide h1{font:800 3.4em/1.05 Georgia,serif;margin:.4em 0}.deck .slide h2{font:700 1.75em/1.2 Georgia,serif;margin:0 0 1em;border:0;padding:0}
.deck .slide-n{position:absolute;right:1em;bottom:.6em;font:600 .75em ui-monospace,monospace;color:var(--ink-2)}
.deck .kick{font:700 .8em ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.deck .big{font-size:1.25em}
.deck .cover{display:flex;flex-direction:column;justify-content:center;height:100%}
.deck .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:.8em;margin:1em 0}.deck .tiles div{border:1px solid var(--line);border-radius:12px;padding:.8em 1em;color:var(--ink-2);font-size:.9em;background:var(--surface-2)}.deck .tiles b{display:block;font:800 2.3em/1.1 Georgia,serif;color:var(--ink)}
.deck .cap{color:var(--ink-2);font-size:.9em;margin:.4em 0 0}.deck ul,.deck ol{margin:.6em 0 0;padding-left:1.2em;font-size:1em}.deck li{margin:.3em 0}
.deck .two{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr);gap:1em;min-height:0;flex:1 1 0}.deck .shot{margin:0;display:flex;flex-direction:column;min-height:0;height:100%}
.deck .shot img{width:100%;flex:1 1 0;min-height:0;object-fit:cover;object-position:top;border:1px solid var(--line);border-radius:10px}.deck .shot figcaption{font-size:.8em;color:var(--ink-2);margin-top:.3em}
.deck .two+ul{font-size:.82em;margin-top:.5em;flex:none}
.deck .heat{width:100%}.deck .heat .hl{font:600 14px system-ui;fill:var(--ink)}.deck .heat .hx{font:11px ui-monospace,monospace;fill:var(--ink-2)}.deck .heat .nil{fill:var(--line)}
.deck .bars .b{display:grid;grid-template-columns:110px 1fr 40px;gap:.8em;align-items:center;margin:.35em 0}.deck .bars i{display:block;height:20px;border-radius:5px}
.deck .dotrow{display:grid;grid-template-columns:90px 22em 1fr;gap:.6em;align-items:center;margin:.5em 0}.deck .dotrow i{display:inline-block;width:22px;height:22px;border-radius:6px;margin-right:4px}.deck .dotrow em{font-style:normal;color:var(--ink-2);font-size:.85em}
.deck .keys{display:grid;grid-template-columns:repeat(4,1fr);gap:1em;margin:1em 0}.deck .keys .k{border:2px dashed var(--line-2);border-radius:14px;padding:1em;opacity:.6}.deck .keys .k.on{border:2px solid var(--c);opacity:1}.deck .keys b{display:block;font-size:1.3em}.deck .keys span{color:var(--ink-2)}
.deck .raci{border-collapse:collapse;font-size:.95em;width:100%}.deck .raci td,.deck .raci th{border:1px solid var(--line);padding:.35em .5em;text-align:center}.deck .raci td:first-child{text-align:left}
.deck .rA{background:var(--accent);color:var(--accent-ink);font-weight:800}.deck .rR{background:var(--accent-soft);font-weight:700}.deck .rC{color:var(--ink)}.deck .rI{color:var(--ink-2)}
.deck .three{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;min-height:0;flex:1 1 0;overflow:hidden}.deck .three h3{margin:0 0 .3em;font-size:1em}.deck .pts{list-style:none;padding:0;margin:0;font-size:.72em}.deck .pts li{margin:.25em 0;padding-left:.5em;border-left:4px solid var(--line-2)}.deck .pts li.late{border-color:var(--warm)}.deck .pts li.today{border-color:var(--accent)}.deck .pts span{display:block;color:var(--ink-2)}.deck .decide li{font-size:1.1em;margin:.5em 0}
.deck.one .slide{display:none;margin:0}.deck.one .slide.current{display:flex}.deck.one>:not(.slide):not(.deck-bar){display:none}
.deck .deck-bar{display:flex;align-items:center;gap:.5em;flex-wrap:wrap;margin:.8em 0 1.2em}.deck .deck-bar button,.deck .deck-pdf{font:inherit;font-size:.9em;font-weight:700;padding:.45em .9em;border-radius:10px;border:1px solid var(--line-2);background:var(--surface);color:var(--ink);cursor:pointer;text-decoration:none}
.deck .deck-bar [data-prev],.deck .deck-bar [data-next]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);min-width:3em}.deck .deck-bar button:disabled{opacity:.35;cursor:default}
.deck .deck-pos{font:600 .9em ui-monospace,monospace;min-width:4.5em;text-align:center}.deck .deck-gap{flex:1}
.deck.all .deck-bar{position:sticky;bottom:0;background:var(--bg);padding:.5em 0;margin:0}
.deck.full,.deck:fullscreen{position:fixed;inset:0;z-index:1000;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1vh 2vw;font-size:clamp(14px,1.45vw,26px)}
.deck.full .slide.current,.deck:fullscreen .slide.current{width:min(96vw,150vh)}.deck.full .deck-bar,.deck:fullscreen .deck-bar{width:min(96vw,150vh);margin:.6em 0 0}
html.deck-on body{overflow:hidden}
@media (max-width:760px){.deck .slide{aspect-ratio:auto;min-height:70vh;padding:1.1em;overflow:visible}.deck .two,.deck .tiles,.deck .keys,.deck .three{grid-template-columns:1fr}.deck .two{flex:none}.deck .shot img{flex:none;height:auto;max-height:45vh}
.deck .slide h1{font-size:2.2em}.deck .slide h2{font-size:1.35em}.deck .dotrow{grid-template-columns:5em 1fr}.deck .dotrow em{grid-column:1/-1}.deck .raci{font-size:.75em}.deck .bars .b{grid-template-columns:5em 1fr 2.5em}.deck .three{flex:none;overflow:visible}.deck .deck-gap{display:none}}
@media print{.deck .deck-bar{display:none}}
</style>
<div class="deck one" data-pdf="../../../assets/shows/2026-11-05-1800/deck.pdf"><section class="slide" aria-label="cover"><div class="cover"><p class="kick">RiskMandate · Web Summit Lisbon 2026 · the team</p><h1>The 18:00 stand-up</h1>
<p class="big">Thursday 5 November 2026 · 18:00 Lisbon · <b>4 days</b> to opening night (Mon 9 Nov), our stand Thu 12 Nov</p>
<div class="tiles"><div><b>108</b>agent commits since the last stand-up</div><div><b>78</b>releases</div><div><b>36</b>agents at work since then</div><div><b>6 of 7</b>people with a site key</div></div>
<p class="cap">Built from the repository at 17:28 UTC. Nobody was asked what they did.</p></div></section><section class="slide" aria-label="Urgent, late and logistics"><h2>Open points first: urgent, late, logistics</h2><div class="three"><div><h3>Late (72)</h3><ul class="pts"><li class="late"><b>WS-50</b> The journalist&#x27;s report every two hours, and a daily newsletter <span>from Mon 2 Nov · dinis · open</span></li><li class="late"><b>WS-56</b> The shirt messages: RiskMandate openers <span>Mon 2 Nov · sarah, nimay, indi · open</span></li><li class="late"><b>WS-62</b> Vote on the design <span>Mon 2 Nov, 16:00 · everyone · open</span></li><li class="late"><b>WS-63</b> The final design set, approved, and the print files <span>Mon 2 Nov, 20:00 · sarah, dinis · in progress</span></li><li class="late"><b>WS-01</b> Get to L1: a dedicated Claude account for this work <span>Tue 3 Nov · everyone · open</span></li><li class="late"><b>WS-02</b> Get to L2: GitHub, push access to this repository, and an email you can send from <span>Tue 3 Nov · everyone · open</span></li><li class="late"><b>WS-09</b> Add everyone&#x27;s GitHub account to the repository <span>Tue 3 Nov · dinis · open</span></li><li class="late"><b>WS-10</b> Workspace email accounts where they are needed <span>Tue 3 Nov · dinis · open</span></li><li class="late"><b>WS-105</b> Protect main: pull requests only, merged by Dinis <span>Tue 3 Nov · dinis, angelo · picked</span></li><li class="more">and 63 more on the board</li></ul></div><div><h3>Due today (37)</h3><ul class="pts"><li class="today"><b>WS-05</b> Get to L5 and L6: several agents, then several scheduled sessions <span>Thu 5 Nov · everyone · open</span></li><li class="today"><b>WS-110</b> Every ABP barrier classified as control, accepted risk or hope, in one table on /abp/ <span>Thu 5 Nov · dinis · open</span></li><li class="today"><b>WS-111</b> The keys page&#x27;s missing fields, and a gate check on who may publish a key <span>Thu 5 Nov · dinis · open</span></li><li class="today"><b>WS-117</b> Sign in with pki.sgit.ai, on a signing origin of its own <span>Thu 5 Nov · dinis, angelo, jose · open</span></li><li class="today"><b>WS-127</b> A scheduled run says so in its commit, so &quot;on a schedule&quot; and the mentors&#x27; clock can be read fr <span>Thu 5 Nov · dinis, angelo · open</span></li><li class="today"><b>WS-131</b> Tools that read git history say so, or deepen the clone, when the clone is shallow <span>Thu 5 Nov · dinis, angelo · picked</span></li><li class="today"><b>WS-133</b> Code in a person&#x27;s folder runs in CI with a token that can push and deploy <span>Thu 5 Nov · dinis · open</span></li><li class="today"><b>WS-138</b> A person&#x27;s signature on the site is also their conductor&#x27;s <span>Thu 5 Nov · dinis · open</span></li><li class="today"><b>WS-141</b> The newsroom: a reader-first patch, and six publishing roles to decide <span>Thu 5 Nov · dinis, indi · open</span></li><li class="more">and 28 more</li></ul></div><div><h3>Logistics (18)</h3><ul class="pts"><li class="logi"><b>WS-108</b> Jose&#x27;s two apps (Hack the Agent, ReachCheck) as the stand demos, if Jose agrees <span>Wed 4 Nov · jose, dinis · picked</span></li><li class="logi"><b>WS-109</b> The grant, not the prompt&quot; as the one demo, and its lines for the shirts and the stand <span>Wed 4 Nov · dinis, everyone · open</span></li><li class="logi"><b>WS-113</b> Print files ready for sign-off, and an Official Sign-off on /print/ that everyone signs with th <span>Tue 3 Nov, 16:00 · dinis, everyone · open</span></li><li class="logi"><b>WS-13</b> The merch budget <span>Wed 4 Nov, 12:00 · dinis · open</span></li><li class="logi"><b>WS-142</b> Synthetic users for the business cards: five invented people get a card, scan it and say what t <span>Thu 5 Nov · indi, dinis · open</span></li><li class="logi"><b>WS-144</b> designer@web-summit.indi writes in team/designer/ and content/, and is not in Indi&#x27;s agents.jso <span>Thu 5 Nov · indi · open</span></li><li class="logi"><b>WS-146</b> The /meet/ pages, before the cards are printed: no key box for visitors, a working contact, the <span>Fri 6 Nov · dinis · open</span></li><li class="logi"><b>WS-155</b> The business cards and stickers, ordered from ProntaPrint Chiswick for Friday 6 November <span>Thu 5 Nov, 09:00 · dinis, indi · open</span></li><li class="logi"><b>WS-156</b> Vault keys should not collect in the conductor&#x27;s session <span>Thu 5 Nov, before the first vault key is sent over the inbox · dinis · open</span></li></ul></div></div><p class="cap">From the board at build time: open issues past their due date, due today, and logistics (merch, print, travel, the stand). At Angelo's ask (a signed message, 17:25).</p></section><section class="slide" aria-label="The day, hour by hour"><h2>Who worked when: commits per hour, per person (their agents), since the last stand-up</h2><svg viewBox="0 0 1000 234" class="heat" role="img" aria-label="Commits per hour, per person"><text x="0" y="22" class="hl">Dinis</text><rect x="110.0" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="0.80"><title>Dinis Cruz, 12:00 UTC: 8</title></rect><rect x="258.3" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="0.32"><title>Dinis Cruz, 13:00 UTC: 1</title></rect><rect x="406.7" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="0.66"><title>Dinis Cruz, 14:00 UTC: 6</title></rect><rect x="555.0" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="0.66"><title>Dinis Cruz, 15:00 UTC: 6</title></rect><rect x="703.3" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="1.00"><title>Dinis Cruz, 16:00 UTC: 11</title></rect><rect x="851.7" y="4" width="146.8" height="26" rx="3" fill="#111827" opacity="0.45"><title>Dinis Cruz, 17:00 UTC: 3</title></rect><text x="0" y="56" class="hl">Angelo</text><rect x="110.0" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.52"><title>Angelo, 12:00 UTC: 4</title></rect><rect x="258.3" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.39"><title>Angelo, 13:00 UTC: 2</title></rect><rect x="406.7" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.39"><title>Angelo, 14:00 UTC: 2</title></rect><rect x="555.0" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.39"><title>Angelo, 15:00 UTC: 2</title></rect><rect x="703.3" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.59"><title>Angelo, 16:00 UTC: 5</title></rect><rect x="851.7" y="38" width="146.8" height="26" rx="3" fill="#15803d" opacity="0.52"><title>Angelo, 17:00 UTC: 4</title></rect><text x="0" y="90" class="hl">Jose</text><rect x="110.0" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.73"><title>Jose Bota, 12:00 UTC: 7</title></rect><rect x="258.3" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.32"><title>Jose Bota, 13:00 UTC: 1</title></rect><rect x="406.7" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.59"><title>Jose Bota, 14:00 UTC: 5</title></rect><rect x="555.0" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.39"><title>Jose Bota, 15:00 UTC: 2</title></rect><rect x="703.3" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.32"><title>Jose Bota, 16:00 UTC: 1</title></rect><rect x="851.7" y="72" width="146.8" height="26" rx="3" fill="#0e7490" opacity="0.32"><title>Jose Bota, 17:00 UTC: 1</title></rect><text x="0" y="124" class="hl">Vicky</text><rect x="110.0" y="106" width="146.8" height="26" rx="3" fill="#7c3aed" opacity="0.93"><title>Vicky Wang, 12:00 UTC: 10</title></rect><rect x="258.3" y="106" width="146.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 13:00 UTC: 1</title></rect><rect x="406.7" y="117" width="146.8" height="4" rx="2" class="nil"/><rect x="555.0" y="106" width="146.8" height="26" rx="3" fill="#7c3aed" opacity="0.39"><title>Vicky Wang, 15:00 UTC: 2</title></rect><rect x="703.3" y="106" width="146.8" height="26" rx="3" fill="#7c3aed" opacity="0.39"><title>Vicky Wang, 16:00 UTC: 2</title></rect><rect x="851.7" y="106" width="146.8" height="26" rx="3" fill="#7c3aed" opacity="0.32"><title>Vicky Wang, 17:00 UTC: 1</title></rect><text x="0" y="158" class="hl">Silvio</text><rect x="110.0" y="140" width="146.8" height="26" rx="3" fill="#b91c1c" opacity="0.32"><title>Silvio Switha, 12:00 UTC: 1</title></rect><rect x="258.3" y="140" width="146.8" height="26" rx="3" fill="#b91c1c" opacity="0.32"><title>Silvio Switha, 13:00 UTC: 1</title></rect><rect x="406.7" y="140" width="146.8" height="26" rx="3" fill="#b91c1c" opacity="0.66"><title>Silvio Switha, 14:00 UTC: 6</title></rect><rect x="555.0" y="140" width="146.8" height="26" rx="3" fill="#b91c1c" opacity="0.32"><title>Silvio Switha, 15:00 UTC: 1</title></rect><rect x="703.3" y="140" width="146.8" height="26" rx="3" fill="#b91c1c" opacity="0.66"><title>Silvio Switha, 16:00 UTC: 6</title></rect><rect x="851.7" y="151" width="146.8" height="4" rx="2" class="nil"/><text x="0" y="192" class="hl">Indi</text><rect x="110.0" y="174" width="146.8" height="26" rx="3" fill="#c2410c" opacity="0.39"><title>Indi Gupte, 12:00 UTC: 2</title></rect><rect x="258.3" y="185" width="146.8" height="4" rx="2" class="nil"/><rect x="406.7" y="185" width="146.8" height="4" rx="2" class="nil"/><rect x="555.0" y="174" width="146.8" height="26" rx="3" fill="#c2410c" opacity="0.32"><title>Indi Gupte, 15:00 UTC: 1</title></rect><rect x="703.3" y="174" width="146.8" height="26" rx="3" fill="#c2410c" opacity="0.39"><title>Indi Gupte, 16:00 UTC: 2</title></rect><rect x="851.7" y="174" width="146.8" height="26" rx="3" fill="#c2410c" opacity="0.32"><title>Indi Gupte, 17:00 UTC: 1</title></rect><text x="110.0" y="224" class="hx">05 Nov 12:00</text></svg><p class="cap">Each square is an hour; darker is more.</p></section><section class="slide" aria-label="The agents"><h2>36 agents did work today; 57 keys on the keys page</h2><div class="dotrow"><span>Dinis</span><span class="ds"><i style="background:#111827" title="abp@web-summit.dinis"></i><i style="background:#111827" title="conductor@web-summit.dinis"></i><i style="background:#111827" title="crm@web-summit.dinis"></i><i style="background:#111827" title="designer@web-summit.dinis"></i><i style="background:#111827" title="dev@web-summit.dinis"></i><i style="background:#111827" title="journalist@web-summit.dinis"></i><i style="background:#111827" title="mentor@web-summit.dinis"></i><i style="background:#111827" title="observability@web-summit.dinis"></i><i style="background:#111827" title="project-manager@web-summit.dinis"></i><i style="background:#111827" title="pulse@web-summit.dinis"></i><i style="background:#111827" title="sgit@web-summit.dinis"></i></span><em>11: abp, conductor, crm, designer, dev, journalist, mentor, observability, project-manager, pulse, sgit</em></div><div class="dotrow"><span>Angelo</span><span class="ds"><i style="background:#15803d" title="conductor@web-summit.angelo"></i><i style="background:#15803d" title="crm@web-summit.angelo"></i><i style="background:#15803d" title="dashboard@web-summit.angelo"></i><i style="background:#15803d" title="dev@web-summit.angelo"></i><i style="background:#15803d" title="helper@web-summit.angelo"></i><i style="background:#15803d" title="team-collaboration@web-summit.angelo"></i></span><em>6: conductor, crm, dashboard, dev, helper, team-collaboration</em></div><div class="dotrow"><span>Jose</span><span class="ds"><i style="background:#0e7490" title="automation@web-summit.jose"></i><i style="background:#0e7490" title="conductor@web-summit.jose"></i><i style="background:#0e7490" title="dashboard@web-summit.jose"></i><i style="background:#0e7490" title="dev@web-summit.jose"></i><i style="background:#0e7490" title="sales-coach@web-summit.jose"></i><i style="background:#0e7490" title="watcher@web-summit.jose"></i></span><em>6: automation, conductor, dashboard, dev, sales-coach, watcher</em></div><div class="dotrow"><span>Vicky</span><span class="ds"><i style="background:#7c3aed" title="conductor@web-summit.vicky"></i><i style="background:#7c3aed" title="curator@web-summit.vicky"></i><i style="background:#7c3aed" title="dashboard@web-summit.vicky"></i><i style="background:#7c3aed" title="logistics@web-summit.vicky"></i><i style="background:#7c3aed" title="pm@web-summit.vicky"></i></span><em>5: conductor, curator, dashboard, logistics, pm</em></div><div class="dotrow"><span>Silvio</span><span class="ds"><i style="background:#b91c1c" title="conductor@web-summit.silvio"></i><i style="background:#b91c1c" title="dev@web-summit.silvio"></i><i style="background:#b91c1c" title="inbox@web-summit.silvio"></i><i style="background:#b91c1c" title="outreach@web-summit.silvio"></i><i style="background:#b91c1c" title="procurement@web-summit.silvio"></i></span><em>5: conductor, dev, inbox, outreach, procurement</em></div><div class="dotrow"><span>Indi</span><span class="ds"><i style="background:#c2410c" title="conductor@web-summit.indi"></i><i style="background:#c2410c" title="dashboard@web-summit.indi"></i><i style="background:#c2410c" title="dev@web-summit.indi"></i></span><em>3: conductor, dashboard, dev</em></div><p class="cap">One dot per agent that committed under its own name since the last stand-up.</p></section><section class="slide" aria-label="Since the 12:00"><h2>Since the 12:00: who moved what</h2><div class="bars"><div class="b"><span>Dinis</span><i style="width:100%;background:#111827"></i><b>35</b></div><div class="b"><span>Angelo</span><i style="width:54%;background:#15803d"></i><b>19</b></div><div class="b"><span>Jose</span><i style="width:49%;background:#0e7490"></i><b>17</b></div><div class="b"><span>Vicky</span><i style="width:46%;background:#7c3aed"></i><b>16</b></div><div class="b"><span>Silvio</span><i style="width:43%;background:#b91c1c"></i><b>15</b></div><div class="b"><span>Indi</span><i style="width:17%;background:#c2410c"></i><b>6</b></div></div><p class="cap">Commits since 12:00, by person (their agents).</p><ul><li><b>The team CRM is live</b> (WS-170): a public vault (313 companies, 249 people, 210 sessions, a graph) and a private one; keys to people and conductors</li><li><b>CRM agents</b>: crm@angelo running (a first write to the public CRM), crm@dinis started (the Brazilian delegation staged), Silvio's and Jose's asked</li><li><b>The 12:00 was recorded</b> (team-collaboration@angelo): one decision, nine follow-ups with owners</li><li><b>The sticker vote closed</b> at 14:30: 2 of 6 voted (Silvio, Angelo); The keys leads</li><li><b>Every agent has an inbox lane</b> to the conductor (49); Angelo's conductor has its own inbox too</li></ul></section><section class="slide" aria-label="The team CRM"><h2>The team CRM: a public vault and a private one</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-05-1800/crm-browse.jpg" alt="/crm/: the public CRM, browsed live from its vault" loading="lazy"><figcaption>/crm/: the public CRM, browsed live from its vault</figcaption></figure><figure class="shot"><img src="../../../assets/shows/2026-11-05-1800/crm-dance.jpg" alt="The private CRM&#x27;s app inside the page" loading="lazy"><figcaption>The private CRM&#x27;s app inside the page</figcaption></figure></div><ul><li><b>Public</b>: facts with sources only, never contact details; <b>private</b>: the team's actions and requests</li><li><b>The second layer</b> (records sealed to their readers) is built and <b>paused</b> at Dinis's word: the vault key is the access for now</li><li><b>Who writes</b>: each person's CRM agent, with the key their conductor seals to it (WS-172)</li></ul></section><section class="slide" aria-label="The sticker vote"><h2>The sticker vote: closed at 14:30</h2><ul><li><b>2 of 6 ballots</b> (Silvio, Angelo), both verified; The keys 19, the road-trip patch 16, Least privilege 16, the tram ticket 15</li><li><b>Extend it?</b> Four of us did not vote; the point was also to test the flow for everyone</li></ul></section><section class="slide" aria-label="To decide now"><h2>To decide at this stand-up</h2><ol class="decide"><li><b>Outreach</b>: Dinis approves the emails' one claim, so Silvio sends from Friday</li><li><b>The merch, Monday 9 Nov</b>: Dinis collects by car near Lisbon, or the printer delivers</li><li><b>Online slots</b>: 4 to 6 half-hours in the week of 16 Nov for 38 large companies not at Web Summit</li><li><b>Meet transcripts to the record</b> (WS-98): Dinis turns them on; the record's writer reads them in Drive</li><li><b>The sticker vote</b>: extend to Friday 12:00, or The keys wins</li><li><b>Access tokens</b> for each conductor's inbox, or each person's own token for now</li></ol></section><section class="slide" aria-label="Follow-ups"><h2>Follow-ups, each with an owner</h2><ul><li><b>Every conductor</b>: open your CRM key; make your inbox lane (Silvio, Vicky, Jose, Indi)</li><li><b>Silvio, Jose</b>: start your CRM agent (the prompt is ready)</li><li><b>crm@web-summit.dinis</b>: the Brazilian delegation into the public CRM</li><li><b>Dinis</b>: the interview shortlist pick (by number); WS-165 (A or B)</li><li><b>Dinis's conductor</b>: record the 18:00 with team-collaboration@angelo; the WS-150 deck patch for tomorrow's 12:00</li></ul></section></div>
