<style>
.deck{--paper:var(--surface);font-size:17px}.deck *{box-sizing:border-box}
.deck .slide{position:relative;aspect-ratio:16/9;background:var(--paper);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:2.2em 2.6em;margin:0 0 1.6em;overflow:hidden;display:flex;flex-direction:column}
.deck .slide h1{font:800 3.4em/1.05 Georgia,serif;margin:.4em 0}.deck .slide h2{font:700 1.75em/1.2 Georgia,serif;margin:0 0 1em;border:0;padding:0}
.deck .slide-n{position:absolute;right:1em;bottom:.6em;font:600 .75em ui-monospace,monospace;color:var(--ink-2)}
.deck .kick{font:700 .8em ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.deck .big{font-size:1.25em}
.deck .cover{display:flex;flex-direction:column;justify-content:center;height:100%}
.deck .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:.8em;margin:1em 0}.deck .tiles div{border:1px solid var(--line);border-radius:12px;padding:.8em 1em;color:var(--ink-2);font-size:.9em;background:var(--surface-2)}.deck .tiles b{display:block;font:800 2.3em/1.1 Georgia,serif;color:var(--ink)}
.deck .cap{color:var(--ink-2);font-size:.9em;margin:.4em 0 0}.deck ul,.deck ol{margin:.6em 0 0;padding-left:1.2em;font-size:1em}.deck li{margin:.3em 0}
.deck .two{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr);gap:1em;min-height:0;flex:1 1 0}.deck .shot{margin:0;display:flex;flex-direction:column;min-height:0;height:100%}
.deck .shot img{width:100%;flex:1 1 0;min-height:0;object-fit:cover;object-position:top;border:1px solid var(--line);border-radius:10px}.deck .shot figcaption{font-size:.8em;color:var(--ink-2);margin-top:.3em}
.deck .two+ul{font-size:.82em;margin-top:.5em;flex:none}
.deck .heat{width:100%}.deck .heat .hl{font:600 14px system-ui;fill:var(--ink)}.deck .heat .hx{font:11px ui-monospace,monospace;fill:var(--ink-2)}.deck .heat .nil{fill:var(--line)}
.deck .bars .b{display:grid;grid-template-columns:110px 1fr 40px;gap:.8em;align-items:center;margin:.35em 0}.deck .bars i{display:block;height:20px;border-radius:5px}
.deck .dotrow{display:grid;grid-template-columns:90px 22em 1fr;gap:.6em;align-items:center;margin:.5em 0}.deck .dotrow i{display:inline-block;width:22px;height:22px;border-radius:6px;margin-right:4px}.deck .dotrow em{font-style:normal;color:var(--ink-2);font-size:.85em}
.deck .keys{display:grid;grid-template-columns:repeat(4,1fr);gap:1em;margin:1em 0}.deck .keys .k{border:2px dashed var(--line-2);border-radius:14px;padding:1em;opacity:.6}.deck .keys .k.on{border:2px solid var(--c);opacity:1}.deck .keys b{display:block;font-size:1.3em}.deck .keys span{color:var(--ink-2)}
.deck .raci{border-collapse:collapse;font-size:.95em;width:100%}.deck .raci td,.deck .raci th{border:1px solid var(--line);padding:.35em .5em;text-align:center}.deck .raci td:first-child{text-align:left}
.deck .rA{background:var(--accent);color:var(--accent-ink);font-weight:800}.deck .rR{background:var(--accent-soft);font-weight:700}.deck .rC{color:var(--ink)}.deck .rI{color:var(--ink-2)}
.deck .three{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;min-height:0;flex:1 1 0;overflow:hidden}.deck .three h3{margin:0 0 .3em;font-size:1em}.deck .pts{list-style:none;padding:0;margin:0;font-size:.72em}.deck .pts li{margin:.25em 0;padding-left:.5em;border-left:4px solid var(--line-2)}.deck .pts li.late{border-color:var(--warm)}.deck .pts li.today{border-color:var(--accent)}.deck .pts span{display:block;color:var(--ink-2)}.deck .decide li{font-size:1.1em;margin:.5em 0}
.deck.one .slide{display:none;margin:0}.deck.one .slide.current{display:flex}.deck.one>:not(.slide):not(.deck-bar){display:none}
.deck .deck-bar{display:flex;align-items:center;gap:.5em;flex-wrap:wrap;margin:.8em 0 1.2em}.deck .deck-bar button,.deck .deck-pdf{font:inherit;font-size:.9em;font-weight:700;padding:.45em .9em;border-radius:10px;border:1px solid var(--line-2);background:var(--surface);color:var(--ink);cursor:pointer;text-decoration:none}
.deck .deck-bar [data-prev],.deck .deck-bar [data-next]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);min-width:3em}.deck .deck-bar button:disabled{opacity:.35;cursor:default}
.deck .deck-pos{font:600 .9em ui-monospace,monospace;min-width:4.5em;text-align:center}.deck .deck-gap{flex:1}
.deck.all .deck-bar{position:sticky;bottom:0;background:var(--bg);padding:.5em 0;margin:0}
.deck.full,.deck:fullscreen{position:fixed;inset:0;z-index:1000;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1vh 2vw;font-size:clamp(14px,1.45vw,26px)}
.deck.full .slide.current,.deck:fullscreen .slide.current{width:min(96vw,150vh)}.deck.full .deck-bar,.deck:fullscreen .deck-bar{width:min(96vw,150vh);margin:.6em 0 0}
html.deck-on body{overflow:hidden}
@media (max-width:760px){.deck .slide{aspect-ratio:auto;min-height:70vh;padding:1.1em;overflow:visible}.deck .two,.deck .tiles,.deck .keys,.deck .three{grid-template-columns:1fr}.deck .two{flex:none}.deck .shot img{flex:none;height:auto;max-height:45vh}
.deck .slide h1{font-size:2.2em}.deck .slide h2{font-size:1.35em}.deck .dotrow{grid-template-columns:5em 1fr}.deck .dotrow em{grid-column:1/-1}.deck .raci{font-size:.75em}.deck .bars .b{grid-template-columns:5em 1fr 2.5em}.deck .three{flex:none;overflow:visible}.deck .deck-gap{display:none}}
@media print{.deck .deck-bar{display:none}}
</style>
<div class="deck one" data-pdf="../../../assets/shows/2026-11-10-1500/deck.pdf"><section class="slide" aria-label="cover"><div class="cover"><p class="kick">PrompTugal.news · Web Summit Lisbon 2026</p><h1>A newsroom of agents, about agents</h1><p class="big">How our agentic team works, what it has delivered in nine days, and where it goes next.</p><p class="cap">Every number here comes from the public record (git, the sites' releases, the live maps) on 10 November 2026. The views shown are live: the links are on the last slide.</p></div></section><section class="slide" aria-label="What pt.news is"><h2>pt.news: the place to learn about agents</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/pt-front.jpg" alt="promptugal.news, live" loading="lazy"><figcaption>promptugal.news, live</figcaption></figure><div><ul><li><b>If you want to learn about agents,</b> be informed about agents, or know what everyone is saying about agents: this is the site</li><li><b>Interviews</b> about what companies do <i>with agents</i>: what their agents do, for whom, with what reach and controls</li><li><b>The summit, now:</b> what is happening at Web Summit, filtered to agents</li><li><b>Scores:</b> every company we cover gets a GAMMA-Ray card, from public evidence</li><li><b>Made by agents, shown openly:</b> each piece shows the workflow that made it</li></ul></div></div></section><section class="slide" aria-label="The team, live"><h2>The team, live: every dot is an agent, every line a message</h2><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/angelo-live.jpg" alt="Angelo&#x27;s live map: six people, their agents, the messages flowing between them, read from the record" loading="lazy"><figcaption>Angelo&#x27;s live map: six people, their agents, the messages flowing between them, read from the record</figcaption></figure></section><section class="slide" aria-label="Deliverables"><h2>What the agents deliver, as it happens</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/angelo-deliverables.jpg" alt="Deliverables: the work flowing out to the CRM, keys, the sites, drafts, infrastructure, the apps, pt.news, research" loading="lazy"><figcaption>Deliverables: the work flowing out to the CRM, keys, the sites, drafts, infrastructure, the apps, pt.news, research</figcaption></figure><div><ul><li><b>A slider replays</b> every exchange since 5 November: watch the team grow</li><li><b>2D and 3D,</b> pop-out and display mode for the stand</li><li><b>Nothing is drawn by hand:</b> it reads the commits, the agents' names and the releases</li></ul></div></div></section><section class="slide" aria-label="The people and the machine"><h2>Nine people, 119 agents that have run, 85 at work in the last 48 hours</h2><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/angelo-collab.jpg" alt="Team and the machine: each person, their agents, what they picked, when each runs next" loading="lazy"><figcaption>Team and the machine: each person, their agents, what they picked, when each runs next</figcaption></figure></section><section class="slide" aria-label="The Universe"><h2>Silvio's Universe: the whole summit and our agents in one live map</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/silvio-cinema.jpg" alt="1,014 points, 1,662 links, read live: Web Summit&#x27;s companies, speakers and sessions joined to our agents and their policies" loading="lazy"><figcaption>1,014 points, 1,662 links, read live: Web Summit&#x27;s companies, speakers and sessions joined to our agents and their policies</figcaption></figure><div><ul><li><b>Live:</b> it reads its sources each time it opens: the team, every agent's behaviour policy, each agent's latest commit, the Web Summit CRM</li><li><b>Circuit view:</b> each agent on a bus, through its policy, barriers, gate and owner, to the resources it may touch</li><li><b>A second brain:</b> capture anything at the stand, Claude files and links it, ask it questions</li></ul></div></div></section><section class="slide" aria-label="GAMMA-Ray"><h2>GAMMA-Ray: how much an agent does on its own, and how well that is governed</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/gamma-spectrum.jpg" alt="GAMMA-Ray Spectrum: seven cards published (beta)" loading="lazy"><figcaption>GAMMA-Ray Spectrum: seven cards published (beta)</figcaption></figure><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/gamma-graph.jpg" alt="Every card is a graph, down to the sentence on a public page" loading="lazy"><figcaption>Every card is a graph, down to the sentence on a public page</figcaption></figure></div><ul><li><b>One short list of questions</b> over 8 public instruments and 279 provisions (Salesforce, Microsoft, SEI and others)</li><li><b>Four dimensions:</b> Autonomy, Reach, Control, Openness; Replit Agent A4 · R2 · C2 · O2, Manus A3 · R2 · C1 · O2</li><li><b>A pipeline of agents</b> scans, reviews and approves; ten Portuguese companies are in review now</li></ul></section><section class="slide" aria-label="FACT-Ray"><h2>FACT-Ray: how far to trust each fact</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/fact-ray.jpg" alt="gamma-ray.sgit.ai/fact-ray/" loading="lazy"><figcaption>gamma-ray.sgit.ai/fact-ray/</figcaption></figure><div><ul><li><b>Trust, not truth:</b> who says it, how firmly it is recorded, who stands behind it</li><li><b>Every fact is scored,</b> for example π Moderate · S1·R5·A1: read by an agent, captured and hashed, checked by two agents, no human yet</li><li><b>Companies answer for themselves</b> with one file on their own domain (/.well-known/fact-ray.json)</li></ul></div></div></section><section class="slide" aria-label="Interviews"><h2>From a noisy recording at the stand to a published interview</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/pt-interviews.jpg" alt="The interview pipeline, public at /newsroom/interviews/" loading="lazy"><figcaption>The interview pipeline, public at /newsroom/interviews/</figcaption></figure><div><ul><li><b>Two interviews live,</b> recorded on the floor, transcribed, drafted, approved by the interviewee, signed</li><li><b>The person steps in</b> where it matters: the conversation, the yes, the approval</li><li><b>Agents do the rest:</b> transcript, draft, facts checked at source, the page, the signature</li></ul></div></div></section><section class="slide" aria-label="How we work"><h2>How we work: a voice brief in, a release out</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/pipeline.jpg" alt="From a voice brief to TestFlight in 1 h 40, traced across five repositories" loading="lazy"><figcaption>From a voice brief to TestFlight in 1 h 40, traced across five repositories</figcaption></figure><div><ul><li><b>A voice brief</b> becomes a brief, then commits by named agents, then a release, then a review</li><li><b>Every push is a version,</b> every page has a gate; every article is signed; every agent has its own key</li><li><b>Conductors</b> route the work; one main conductor, focused ones per team; the humans can stop or restart any of them</li><li><b>Only the operator instructs;</b> agents draft, people send</li></ul></div></div></section><section class="slide" aria-label="Governed agents"><h2>RiskMandate governs our own agents</h2><div class="two"><figure class="shot"><img src="../../../assets/shows/2026-11-10-1500/abp-player.jpg" alt="Agent Behaviour Policies you can watch" loading="lazy"><figcaption>Agent Behaviour Policies you can watch</figcaption></figure><div><ul><li><b>Each agent has a policy:</b> its reach, its mandate and the gap between them</li><li><b>Deny by default,</b> reviewed hourly; security agents review every commit for keys, contact details and private data</li><li><b>We are our own case study:</b> what we do to our agents is what RiskMandate offers</li></ul></div></div></section><section class="slide" aria-label="Nine days"><h2>What we have executed since 2 November</h2><ul><li><b>Two sites, released on every push:</b> the team site (4,716 commits, 1,786 releases) and pt.news (3,070 commits and 979 releases since 5 November; 1,484 pages)</li><li><b>GAMMA-Ray and FACT-Ray:</b> a standard, a site, a scan pipeline and seven published cards, built in a day and a half</li><li><b>Apps:</b> the Team app and the news app on TestFlight (the venue map in Team 0.4.76), the news app on the web, Android with an on-device model</li><li><b>Interviews</b> from the floor to the page; a newsroom of desks, a checker, a reviewer, beat correspondents</li><li><b>The big stop and the restart:</b> every team paused in minutes, realigned, restarted on one theme</li><li><b>The live views:</b> Angelo's map, Silvio's Universe, the command centres for every person</li></ul></section><section class="slide" aria-label="Next"><h2>Next: from the big picture to the detail</h2><ul><li><b>"Each dot is an agent: what is it for?"</b> Small, medium and large examples, from a photo, a video or a voice memo to a live page, a deck or a repository, documented as they happen by a reporter and a journalist agent</li><li><b>The visual newsroom:</b> every piece on pt.news shows its workflow: where the human, the researcher, the journalist and the agents came in</li><li><b>The individual:</b> a photo of someone we meet starts research, a unit of agents and a card on our board</li><li><b>The redesign:</b> pt.news led by the interviews, the summit now and the scores</li></ul></section><section class="slide" aria-label="Live links"><h2>See it live</h2><ul><li><b>Angelo's live map:</b> web-summit.sgit.ai/people/angelo/app/#live (Messages, Workstreams, Deliverables; 3D; Full screen)</li><li><b>Silvio's Universe:</b> web-summit.sgit.ai/people/silvio/app/ then Universe (Play demo, Cinema, Circuit)</li><li><b>pt.news:</b> promptugal.news · the interviews: promptugal.news/newsroom/interviews/</li><li><b>GAMMA-Ray:</b> gamma-ray.sgit.ai/spectrum/ · FACT-Ray: gamma-ray.sgit.ai/fact-ray/</li><li><b>How we work:</b> web-summit.sgit.ai/pipeline/ · the ABPs: web-summit.sgit.ai/people/angelo/proposals/abp-live/player.htm</li></ul></section></div>
<script src="../../../assets/deck.js" defer></script>
