# Python (team/designer/mockups and other helper scripts)
__pycache__/
*.py[cod]

# Local environments and secrets (WS-86): never committable, wherever they land
.env
.env.*
.envrc
.venv
.sg-send/
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
.pypirc
.npmrc
*.log

# Credentials tier: never committed (vault keys, tokens, key stores)
.credentials/

# Generated by admin/build/build.mjs: CI builds and deploys them, so they are never committed (WS-83, 2 Nov 2026).
# The build lists what it wrote in .generated.txt; the gate checks that no source file is ignored.
*.html
index.md
!/content/**
/llms.txt
/sitemap.xml
/admin/versions.md
/about/participant.md
/articles/*.md
/keys/*.json
/.generated.txt
/versions/
/meetings/

# the command centres' data (admin/build/commandcentre.mjs), written by the build for every person
/people/*/app/data.json
/me.json

# sgit: a vault working folder keeps its vault key and access token in .sg_vault/local/; never commit one (vaults belong outside this clone)
.sg_vault/
/agenda.json
